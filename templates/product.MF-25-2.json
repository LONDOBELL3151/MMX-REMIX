        "custom_liquid_gMUz79": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>\u5de6\u9760\u62e2\u5e26Logo\u7684\u6587\u6848\u793a\u4f8b</title>\n    <style>\n        /* \u5bb9\u5668\u6837\u5f0f */\n        .container {\n            display: flex; /* \u4f7f\u7528 Flexbox \u5b9e\u73b0\u5185\u5bb9\u6c34\u5e73\u5bf9\u9f50 */\n            align-items: center; /* \u5782\u76f4\u5c45\u4e2d\u6587\u672c\u548c\u56fe\u7247 */\n            /* \u5bb9\u5668\u7a0d\u5fae\u6bd4logo\u5927\u4e00\u70b9\uff0c\u7559\u51fa\u4e00\u4e9b\u5185\u8fb9\u8ddd */\n            padding: 10px;\n            /* \u80cc\u666f\u900f\u660e\uff0c\u9ed8\u8ba4\u60c5\u51b5\u4e0b\u5c31\u662f\u900f\u660e\u7684\uff0c\u4f46\u660e\u786e\u5199\u51fa\u6765\u66f4\u6e05\u6670 */\n            background-color: transparent;\n            /* \u5de6\u5bf9\u9f50\u662f\u9ed8\u8ba4\u884c\u4e3a\uff0c\u4f46\u5982\u679c\u7236\u5143\u7d20\u6709\u5c45\u4e2d\u7b49\u8bbe\u7f6e\uff0c\u52a0\u4e0a\u8fd9\u884c\u66f4\u4fdd\u9669 */\n            margin-right: auto;\n            width: fit-content; /* \u5bbd\u5ea6\u9002\u5e94\u5185\u5bb9\u5927\u5c0f */\n        }\n\n        \n        /* Logo\u56fe\u7247\u6837\u5f0f */\n        .logo-img {\n            width: 100px; /* \u8bbe\u7f6e Logo \u5bbd\u5ea6 */\n            height: 100px; /* \u8bbe\u7f6e Logo \u9ad8\u5ea6 */\n            /* \u589e\u52a0 Logo \u548c\u6587\u6848\u4e4b\u95f4\u7684\u95f4\u8ddd */\n            margin-right: 15px; \n            /* \u5782\u76f4\u5bf9\u9f50\uff0c\u9632\u6b62\u56fe\u7247\u5e95\u90e8\u51fa\u73b0\u7a7a\u9699 */\n            display: block;\n        }\n\n        /* \u6587\u6848\u6837\u5f0f */\n        .text-content-1 {\n            color: #121212; /* \u8bbe\u7f6e\u6587\u6848\u989c\u8272 */\n            font-size: 15px; /* \u793a\u4f8b\u5b57\u53f7\uff0c\u53ef\u4ee5\u6839\u636e\u9700\u8981\u8c03\u6574 */\n            line-height: 1.5; /* \u793a\u4f8b\u884c\u9ad8 */\n        }\n        .text-content-2 {\n            color: #121212; /* \u8bbe\u7f6e\u6587\u6848\u989c\u8272 */\nfont-weight: bold;\n            font-size: 15px; /* \u793a\u4f8b\u5b57\u53f7\uff0c\u53ef\u4ee5\u6839\u636e\u9700\u8981\u8c03\u6574 */\n            line-height: 0.5; /* \u793a\u4f8b\u884c\u9ad8 */\n        }\n        .text-content-3 {\n            color: #121212; /* \u8bbe\u7f6e\u6587\u6848\u989c\u8272 */\n            font-size: 12px; /* \u793a\u4f8b\u5b57\u53f7\uff0c\u53ef\u4ee5\u6839\u636e\u9700\u8981\u8c03\u6574 */\n            line-height: 0.5; /* \u793a\u4f8b\u884c\u9ad8 */\n        }\n    </style>\n</head>\n<body>\n\n<div class=\"container\">\n        <img src=\"https://cdn.shopify.com/s/files/1/0081/3039/6242/files/1_b6cd1bf2-6733-4b26-a8ad-08d4a60f529f.png?v=1760004997\" alt=\"Logo\" class=\"logo-img\">\n    </a>\n    <p>\n    <span class=\"text-content-1\">\n      Black Friday Bundle Sale:\n    </span><br>\n    <span class=\"text-content-2\">\n      Order MF-25 with the front basket and get $20 off.\n    </span><br>\n    <span class=\"text-content-3\">\n     The discount will automatically be applied at checkout.\n    </span>\n    </p>\n</div>\n\n</body>\n</html>"
