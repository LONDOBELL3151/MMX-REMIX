uff0c\u53ef\u4ee5\u51cf\u5c11\u6a21\u7cca\u534a\u5f84\uff0c\u751a\u81f3\u4e0d\u8bbe\u6a21\u7cca\u534a\u5f84 */\n            /* box-shadow: 5px 5px 0px rgba(0, 0, 0, 0.5); /* \u66f4\u786c\u6717\u7684\u8fb9\u6846\u6548\u679c */\n        }\n\n        /* --------------------------------------\n           !!! \u5df2\u79fb\u9664 .logo-img \u6837\u5f0f\uff0c\u56e0\u4e3a\u4e0d\u518d\u9700\u8981\u56fe\u7247\n        -------------------------------------- */\n        \n        /* \u6587\u6848\u6837\u5f0f */\n        .text-content-1 {\n            color: #121212; /* \u8bbe\u7f6e\u6587\u6848\u989c\u8272 */\n            font-size: 15px; /* \u793a\u4f8b\u5b57\u53f7\uff0c\u53ef\u4ee5\u6839\u636e\u9700\u8981\u8c03\u6574 */\n            line-height: 1.5; /* \u793a\u4f8b\u884c\u9ad8 */\n            display: inline-block; \n        }\n        .text-content-2 {\n            color: #121212; /* \u8bbe\u7f6e\u6587\u6848\u989c\u8272 */\n            font-weight: bold;\n            font-size: 15px; /* \u793a\u4f8b\u5b57\u53f7\uff0c\u53ef\u4ee5\u6839\u636e\u9700\u8981\u8c03\u6574 */\n            line-height: 1.5; /* \u793a\u4f8b\u884c\u9ad8 */\n            display: inline-block;\n        }\n        .text-content-3 {\n            color: #121212; /* \u8bbe\u7f6e\u6587\u6848\u989c\u8272 */\n            font-size: 12px; /* \u793a\u4f8b\u5b57\u53f7\uff0c\u53ef\u4ee5\u6839\u636e\u9700\u8981\u8c03\u6574 */\n            line-height: 0.5; /* \u793a\u4f8b\u884c\u9ad8 */\n            display: inline-block;\n        }\n    </style>\n</head>\n<body>\n\n<div class=\"container\">\n    <p>\n    <span class=\"text-content-1\">\n      <span class=\"text-content-2\"></span>Preorder:\n    </span><br>\n    <span class=\"text-content-2\">\n      Expected to ship in early March.\n    </span><br>\n    <span class=\"text-content-3\">\n      Brooklyn Gray is available and ready to ship.\n    </span>\n    </p>\n</div>\n\n</body>\n</html>"
