    "faq": {
      "type": "faq",
      "blocks": {
        "question_assembly": {
          "type": "question",
          "settings": {
            "question": "What are the folded dimensions of the MF-35?",
            "answer": "<p>When folded, the MF-35 folding electric tricycle measures 66\" L * 23.5\" W * 46.5\" H. Its folding design helps reduce its storage footprint for garages, sheds, RV travel, and transport. Please measure your intended storage space before purchase.</p>"
          }
        },
        "question_battery": {
          "type": "question",
          "settings": {
            "question": "Why choose the MF-35 folding electric trike?",
            "answer": "<p>The MF-35 folding electric trike gives you the confidence, carrying capability, and electric assist of a full-size trike without demanding full-time storage space. Use it for errands, neighborhood rides, and everyday cargo, then fold it down to make storage, RV travel, and transport more manageable.</p>"
          }
        },
        "question_trial": {
          "type": "question",
          "settings": {
            "question": "Will the MF-35 folding electric tricycle fit in my car trunk?",
            "answer": "<p>The MF-35 folding electric tricycle folds for easier transport, but fit depends on your vehicle. It may fit in larger SUVs, vans, pickup beds, or vehicles with fold-flat rear seats. Please compare your vehicle’s cargo space and payload capacity with the MF-35’s folded dimensions and weight before purchase; two people may be needed for loading.</p>"
          }
        },
        "question_legal": {
          "type": "question",
          "settings": {
            "question": "Who is the MF-35 folding electric tricycle best suited for?",
            "answer": "<p>The MF-35 folding electric tricycle is designed for adult riders who value the added confidence of three wheels, electric assistance for everyday trips, and practical capacity for errands or gear. Its adjustable saddle post and Telescopic handlebar stem are designed to accommodate riders from 5'1\" to 5'9\".</p>"
          }
        },
        "question_warranty": {
          "type": "question",
          "settings": {
            "question": "What range can I expect on a charge?",
            "answer": "<p>The MF-35 folding electric trike offers a range of up to 50 miles under ideal riding conditions. Actual range varies based on rider and cargo weight, terrain, tire pressure, temperature, battery condition, assist level, throttle use, and riding style.</p>"
          }
        }
      },
