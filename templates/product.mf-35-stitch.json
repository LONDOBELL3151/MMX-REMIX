      "settings": {
        "kicker": "// POWERTRAIN & CHASSIS DYNAMICS",
        "heading": "ENGINEERED FOR ABSOLUTE STABILITY",
        "subheading": "The MF-35 integrates proprietary differential rear-wheel drive and balanced weight distribution for zero-lean riding confidence on pavement, gravel, and grass.",
        "padding_top": 60,
