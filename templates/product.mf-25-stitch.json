    "feature_1": {
      "type": "mf25-stitch-feature",
      "settings": {
        "desktop_layout": "image_right",
        "eyebrow": "",
        "title": "Conquer Every Hill with 1100W Peak Power",
        "body": "While most budget-friendly e-bikes cut costs with underpowered motors that stall on steep inclines, we focus on delivering real climbing power when you need it most. As a high-performance electric bike for commuting, the Maxfoot MF-25 packs a high-torque motor with 1100W of peak power, absorbing the strain of heavy acceleration and steep hills before it ever reaches your knees.\n<br>\nWhether pulling away smoothly from a busy intersection or conquering the steep slope back home, you always have dependable momentum at your fingertips. Simply press the throttle or engage pedal assist for an effortless, sweat-free ride without ever pushing your bike uphill.",
        "image": "shopify://shop_images/25mm1200.png"
      }
    },
    "feature_2": {
      "type": "mf25-stitch-feature",
      "settings": {
        "desktop_layout": "image_left",
        "eyebrow": "",
        "title": "Go Further with the 500Wh Removable Battery",
        "body": "Enjoy extended rides with our high-capacity 500Wh lithium-ion battery. It's easily removable for convenient indoor charging and provides reliable, long-range power for all your commuting and recreational needs.",
        "image": "shopify://shop_images/25bb1200.png"
      }
    },
    "feature_3": {
      "type": "mf25-stitch-feature",
      "settings": {
        "desktop_layout": "image_right",
        "eyebrow": "",
        "title": "Glide Over Bumps with Dual Suspension & Step-Thru Frame",
        "body": "Unlike standard e-bikes that offer no rear cushioning to save on costs, we focus on protecting your spine and knees from harsh road impacts. Built as a comfortable commuter electric bike for adults, the MF-25 combines a front suspension fork with a cushioned suspension seatpost to absorb bumps, potholes, and speed bumps before they reach your body.\n<br>\nPaired with a low Step-Thru frame design, getting on and off is completely effortless in everyday clothing for riders of all ages, delivering a floating, stress-free riding experience.",
        "image": "shopify://shop_images/25ST1200.png"
      }
    },
    "mf25_stitch_feature_j9WyXn": {
      "type": "mf25-stitch-feature",
      "name": "MF25 Stitch Feature",
      "settings": {
        "desktop_layout": "image_left",
        "eyebrow": "",
        "title": "Ride in Total Control with Smart Display & LED Lighting",
        "body": "Where other e-bikes in this price range cut costs with dim displays and basic reflectors, we focus on delivering complete rider visibility and total control day or night. To ensure this is the best commuter electric bike for round-the-clock safety, the MF-25 features an intuitive, full-color LCD screen that stays crystal clear even under direct sunlight so your speed and battery level are always instantly readable.\n<br>\nPaired with integrated LED headlights and an automatic rear brake light that brightens when you slow down, it illuminates your path ahead while warning cars behind you, giving you complete peace of mind on every journey.",
        "image": "shopify://shop_images/25dp.png"
      }
    },
