{% doc %}
  @prompt
    生成一个视频自动播放的section，全宽，有覆盖阴影，阴影百分比可调。左侧可放文案，文案置顶覆盖在阴影之上
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-video-hero-{{ ai_gen_id }} {
    display: block;
    position: relative;
    width: 100%;
    max-width: 100%;
    overflow: hidden;
    background: #121212;
    isolation: isolate;
  }

  .ai-video-hero-{{ ai_gen_id }}__media {
    position: relative;
    width: 100%;
    height: {{ block.settings.video_height }}px;
  }

  .ai-video-hero-{{ ai_gen_id }}__media video {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-video-hero-{{ ai_gen_id }}__placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #f2f2f2;
  }

  .ai-video-hero-{{ ai_gen_id }}__placeholder svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-video-hero-{{ ai_gen_id }}__empty {
    position: absolute;
    left: 50%;
    bottom: 20px;
    transform: translateX(-50%);
    padding: 8px 12px;
    color: #333333;
    background: #ffffff;
    font-size: 14px;
    text-align: center;
  }

  .ai-video-hero-{{ ai_gen_id }}__shade {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: rgba(0, 0, 0, {{ block.settings.overlay_opacity | divided_by: 100.0 }});
    pointer-events: none;
  }

  .ai-video-hero-{{ ai_gen_id }}__content {
    position: absolute;
    z-index: 2;
    top: 0;
    left: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-start;
    width: 100%;
    max-width: 720px;
    padding: {{ block.settings.content_padding }}px;
    color: {{ block.settings.text_color }};
    text-align: left;
  }

  .ai-video-hero-{{ ai_gen_id }}__heading {
    margin: 0 0 12px;
    color: inherit;
    font-size: clamp(28px, 4vw, {{ block.settings.heading_size }}px);
    line-height: 1.1;
  }

  .ai-video-hero-{{ ai_gen_id }}__copy {
    font-size: {{ block.settings.body_size }}px;
    line-height: 1.5;
  }

  .ai-video-hero-{{ ai_gen_id }}__copy p {
    margin: 0 0 12px;
  }

  .ai-video-hero-{{ ai_gen_id }}__copy p:last-child {
    margin-bottom: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-video-hero-{{ ai_gen_id }}__media {
      height: {{ block.settings.mobile_video_height }}px;
    }

    .ai-video-hero-{{ ai_gen_id }}__content {
      padding: 24px;
    }

    .ai-video-hero-{{ ai_gen_id }}__heading {
      font-size: clamp(26px, 8vw, {{ block.settings.heading_size }}px);
    }
  }
{% endstyle %}

<div class="ai-video-hero-{{ ai_gen_id }}" style="width: {{ block.settings.desktop_width_percent }}%;" {{ block.shopify_attributes }}>
  <div class="ai-video-hero-{{ ai_gen_id }}__media">
    {% if block.settings.video_url != blank %}
      <video autoplay muted loop playsinline preload="metadata" aria-label="{{ block.settings.video_label | escape }}">
        <source src="{{ block.settings.video_url | escape }}" type="video/mp4">
      </video>
    {% else %}
      <div class="ai-video-hero-{{ ai_gen_id }}__placeholder">
        {{ 'hero-apparel-1' | placeholder_svg_tag }}
        <div class="ai-video-hero-{{ ai_gen_id }}__empty">请添加 MP4 视频链接以显示自动播放视频</div>
      </div>
    {% endif %}
    <div class="ai-video-hero-{{ ai_gen_id }}__shade" aria-hidden="true"></div>
    {% if block.settings.heading != blank or block.settings.text != blank %}
      <div class="ai-video-hero-{{ ai_gen_id }}__content">
        {% if block.settings.heading != blank %}
          <h2 class="ai-video-hero-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>
        {% endif %}
        {% if block.settings.text != blank %}
          <div class="ai-video-hero-{{ ai_gen_id }}__copy">{{ block.settings.text }}</div>
        {% endif %}
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "自动播放视频横幅",
  "settings": [
    {
      "type": "header",
      "content": "视频与布局"
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "MP4 视频链接",
      "info": "粘贴 Shopify 文件中的 MP4 视频链接。视频将静音循环自动播放。"
    },
    {
      "type": "text",
      "id": "video_label",
      "label": "视频辅助说明",
      "default": "背景视频"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "桌面宽度",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "video_height",
      "label": "桌面视频高度",
      "min": 300,
      "max": 900,
      "step": 50,
      "unit": "px",
      "default": 600
    },
    {
      "type": "range",
      "id": "mobile_video_height",
      "label": "手机视频高度",
      "min": 250,
      "max": 700,
      "step": 50,
      "unit": "px",
      "default": 450
    },
    {
      "type": "header",
      "content": "覆盖文案"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "标题",
      "default": "探索城市边界"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "正文",
      "default": "<p>以电动骑行，开启每一段新旅程。</p>"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "文案颜色",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "标题字号",
      "min": 28,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "body_size",
      "label": "正文字号",
      "min": 14,
      "max": 28,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "content_padding",
      "label": "文案内边距",
      "min": 16,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "覆盖阴影浓度",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 35
    }
  ],
  "presets": [
    {
      "name": "自动播放视频横幅"
    }
  ],
  "tag": null,
  "class": "video-hero-block"
}
{% endschema %}