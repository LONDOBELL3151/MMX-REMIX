{% doc %}
  @prompt
    生成一个视频自动播放的section，全宽。视频尺寸16:9，有覆盖阴影，阴影百分比可调。左侧可放文案，文案置顶覆盖在阴影之上, 视频要一直自动循环。
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-video-hero-{{ ai_gen_id }} {
    display: block;
    position: relative;
    width: 100%;
    max-width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #1b1b1b;
    color: #ffffff;
  }

  .ai-video-hero-{{ ai_gen_id }}__media,
  .ai-video-hero-{{ ai_gen_id }}__shade {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .ai-video-hero-{{ ai_gen_id }}__media {
    object-fit: cover;
  }

  .ai-video-hero-{{ ai_gen_id }}__shade {
    background: rgba(0, 0, 0, {{ block.settings.overlay_opacity | divided_by: 100.0 }});
    z-index: 1;
    pointer-events: none;
  }

  .ai-video-hero-{{ ai_gen_id }}__content {
    position: absolute;
    z-index: 2;
    top: 0;
    left: 0;
    width: min(100%, 760px);
    padding: clamp(20px, 5vw, 72px);
    color: #ffffff;
  }

  .ai-video-hero-{{ ai_gen_id }}__heading {
    margin: 0 0 14px;
    color: inherit;
    font-size: clamp(28px, 5vw, 64px);
    line-height: 1.08;
  }

  .ai-video-hero-{{ ai_gen_id }}__text {
    color: inherit;
    font-size: clamp(16px, 1.8vw, 21px);
    line-height: 1.5;
  }

  .ai-video-hero-{{ ai_gen_id }}__text p {
    margin: 0;
  }

  .ai-video-hero-{{ ai_gen_id }}__placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #333333;
  }

  .ai-video-hero-{{ ai_gen_id }}__placeholder svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.45;
  }

  .ai-video-hero-{{ ai_gen_id }}__empty-state {
    position: absolute;
    left: 50%;
    bottom: 18px;
    transform: translateX(-50%);
    padding: 8px 12px;
    border-radius: 3px;
    background: rgba(0, 0, 0, 0.72);
    color: #ffffff;
    font-size: 14px;
    text-align: center;
  }

  @media screen and (max-width: 749px) {
    .ai-video-hero-{{ ai_gen_id }}__content {
      padding: 20px;
    }
  }
{% endstyle %}

<div class="ai-video-hero-{{ ai_gen_id }}" style="width: 100%;" {{ block.shopify_attributes }}>
  {% if block.settings.video != blank %}
    {{ block.settings.video | video_tag: class: 'ai-video-hero-' | append: ai_gen_id | append: '__media', autoplay: true, loop: true, muted: true, controls: false, playsinline: true, preload: 'auto' }}
  {% else %}
    <div class="ai-video-hero-{{ ai_gen_id }}__placeholder">
      {{ 'hero-apparel-1' | placeholder_svg_tag }}
      <div class="ai-video-hero-{{ ai_gen_id }}__empty-state">请在编辑器中选择视频</div>
    </div>
  {% endif %}
  <div class="ai-video-hero-{{ ai_gen_id }}__shade" aria-hidden="true"></div>
  {% if block.settings.heading != blank or block.settings.copy != blank %}
    <div class="ai-video-hero-{{ ai_gen_id }}__content">
      {% if block.settings.heading != blank %}<h2 class="ai-video-hero-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>{% endif %}
      {% if block.settings.copy != blank %}<div class="ai-video-hero-{{ ai_gen_id }}__text">{{ block.settings.copy }}</div>{% endif %}
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "自动播放视频横幅",
  "settings": [
    { "type": "video", "id": "video", "label": "视频" },
    { "type": "range", "id": "desktop_width_percent", "label": "桌面宽度", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "overlay_opacity", "label": "覆盖阴影强度", "min": 0, "max": 90, "step": 5, "unit": "%", "default": 35 },
    { "type": "text", "id": "heading", "label": "标题", "default": "探索城市与远方" },
    { "type": "richtext", "id": "copy", "label": "文案", "default": "<p>为每一段旅程而生。</p>" }
  ],
  "presets": [
    { "name": "自动播放视频横幅" }
  ],
  "tag": null,
  "class": "ai-video-hero-block"
}
{% endschema %}