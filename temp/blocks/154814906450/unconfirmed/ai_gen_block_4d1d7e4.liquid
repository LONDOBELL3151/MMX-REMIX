{% doc %}
  @prompt
    生成一个符合黑五主题的倒计时
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-bf-countdown-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    box-sizing: border-box;
    padding: 24px 20px;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    text-align: center;
    border: 1px solid {{ block.settings.accent_color }};
    border-radius: {{ block.settings.corner_radius }}px;
  }
  .ai-bf-countdown-{{ ai_gen_id }}__eyebrow {
    margin: 0 0 6px;
    color: {{ block.settings.accent_color }};
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .16em;
    text-transform: uppercase;
  }
  .ai-bf-countdown-{{ ai_gen_id }}__heading {
    margin: 0 0 18px;
    color: inherit;
    font-size: clamp(22px, 4vw, 34px);
    line-height: 1.15;
  }
  .ai-bf-countdown-{{ ai_gen_id }}__timer {
    display: flex;
    justify-content: center;
    gap: 10px;
    flex-wrap: wrap;
  }
  .ai-bf-countdown-{{ ai_gen_id }}__unit {
    min-width: 68px;
    padding: 12px 10px;
    background: {{ block.settings.tile_color }};
    border-radius: 4px;
  }
  .ai-bf-countdown-{{ ai_gen_id }}__number {
    display: block;
    color: {{ block.settings.text_color }};
    font-size: clamp(24px, 5vw, 38px);
    font-variant-numeric: tabular-nums;
    font-weight: 700;
    line-height: 1;
  }
  .ai-bf-countdown-{{ ai_gen_id }}__label {
    display: block;
    margin-top: 7px;
    color: {{ block.settings.text_color }};
    font-size: 11px;
    letter-spacing: .08em;
    text-transform: uppercase;
  }
  .ai-bf-countdown-{{ ai_gen_id }}__message {
    margin: 16px 0 0;
    font-size: 14px;
  }
  @media screen and (max-width: 480px) {
    .ai-bf-countdown-{{ ai_gen_id }} { padding: 20px 12px; }
    .ai-bf-countdown-{{ ai_gen_id }}__unit { min-width: 58px; padding: 10px 7px; }
  }
{% endstyle %}

<black-friday-countdown-{{ ai_gen_id }} class="ai-bf-countdown-{{ ai_gen_id }}" data-deadline="{{ block.settings.deadline | escape }}" {{ block.shopify_attributes }}>
  <p class="ai-bf-countdown-{{ ai_gen_id }}__eyebrow">{{ block.settings.eyebrow | escape }}</p>
  <h2 class="ai-bf-countdown-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>
  <div class="ai-bf-countdown-{{ ai_gen_id }}__timer" role="timer" aria-live="off" aria-label="倒计时">
    <div class="ai-bf-countdown-{{ ai_gen_id }}__unit"><span class="ai-bf-countdown-{{ ai_gen_id }}__number" data-days>00</span><span class="ai-bf-countdown-{{ ai_gen_id }}__label">天</span></div>
    <div class="ai-bf-countdown-{{ ai_gen_id }}__unit"><span class="ai-bf-countdown-{{ ai_gen_id }}__number" data-hours>00</span><span class="ai-bf-countdown-{{ ai_gen_id }}__label">小时</span></div>
    <div class="ai-bf-countdown-{{ ai_gen_id }}__unit"><span class="ai-bf-countdown-{{ ai_gen_id }}__number" data-minutes>00</span><span class="ai-bf-countdown-{{ ai_gen_id }}__label">分钟</span></div>
    <div class="ai-bf-countdown-{{ ai_gen_id }}__unit"><span class="ai-bf-countdown-{{ ai_gen_id }}__number" data-seconds>00</span><span class="ai-bf-countdown-{{ ai_gen_id }}__label">秒</span></div>
  </div>
  <p class="ai-bf-countdown-{{ ai_gen_id }}__message" data-message>{{ block.settings.note | escape }}</p>
</black-friday-countdown-{{ ai_gen_id }}>

<script>
  (() => {
    const tagName = 'black-friday-countdown-{{ ai_gen_id }}';
    if (customElements.get(tagName)) return;
    class BlackFridayCountdown extends HTMLElement {
      connectedCallback() {
        this.deadline = Date.parse(this.dataset.deadline);
        this.tick = this.tick.bind(this);
        this.tick();
        this.interval = window.setInterval(this.tick, 1000);
      }
      disconnectedCallback() {
        window.clearInterval(this.interval);
      }
      tick() {
        const remaining = Math.max(0, this.deadline - Date.now());
        const seconds = Math.floor(remaining / 1000);
        const values = {
          '[data-days]': Math.floor(seconds / 86400),
          '[data-hours]': Math.floor((seconds % 86400) / 3600),
          '[data-minutes]': Math.floor((seconds % 3600) / 60),
          '[data-seconds]': seconds % 60
        };
        Object.entries(values).forEach(([selector, value]) => {
          const node = this.querySelector(selector);
          if (node) node.textContent = String(value).padStart(2, '0');
        });
        if (remaining <= 0) {
          const message = this.querySelector('[data-message]');
          if (message) message.textContent = {{ block.settings.ended_text | json }};
          window.clearInterval(this.interval);
        }
      }
    }
    customElements.define(tagName, BlackFridayCountdown);
  })();
</script>

{% schema %}
{
  "name": "Black Friday countdown",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Top line", "default": "BLACK FRIDAY EVENT" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Black Friday deals end in" },
    { "type": "text", "id": "deadline", "label": "End date and time (ISO 8601)", "default": "2026-11-28T23:59:59-08:00" },
    { "type": "text", "id": "note", "label": "Supporting text", "default": "Shop the event before it ends." },
    { "type": "text", "id": "ended_text", "label": "After countdown ends", "default": "This Black Friday event has ended." },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#121212" },
    { "type": "color", "id": "tile_color", "label": "Timer tiles", "default": "#292929" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#FFFFFF" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#F2B705" },
    { "type": "range", "id": "corner_radius", "label": "Corner radius", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 4 }
  ],
  "presets": [{ "name": "Black Friday countdown" }],
  "tag": null,
  "class": "black-friday-countdown-block"
}
{% endschema %}