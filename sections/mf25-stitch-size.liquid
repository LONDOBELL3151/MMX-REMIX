
{% render 'mf25-stitch-styles' %}

{%- liquid
  assign s = section.settings
-%}

<section class="mf25-size" {{ section.shopify_attributes }}>
  <div class="container">
    <div class="mf25-size-head">
      <h2>{{ s.title }}</h2>
      <p>{{ s.subtitle }}</p>
    </div>
    <div class="mf25-size-frame">
      {%- if s.image_mobile != blank or s.image != blank -%}
        <picture class="mf25-size-picture">
          {%- if s.image_mobile != blank -%}
            <source
              media="(max-width: 768px)"
              srcset="{{ s.image_mobile | image_url: width: 375 }} 375w, {{ s.image_mobile | image_url: width: 640 }} 640w, {{ s.image_mobile | image_url: width: 750 }} 750w, {{ s.image_mobile | image_url: width: 1080 }} 1080w"
              sizes="100vw">
          {%- endif -%}
          {%- if s.image != blank -%}
            <img
              src="{{ s.image | image_url: width: 1600 }}"
              srcset="{{ s.image | image_url: width: 800 }} 800w, {{ s.image | image_url: width: 1200 }} 1200w, {{ s.image | image_url: width: 1600 }} 1600w"
              sizes="100vw"
              alt="{{ s.title | escape }}"
              loading="lazy"
              width="1600"
              height="1200">
          {%- else -%}
            <img
              src="{{ s.image_mobile | image_url: width: 1080 }}"
              srcset="{{ s.image_mobile | image_url: width: 375 }} 375w, {{ s.image_mobile | image_url: width: 640 }} 640w, {{ s.image_mobile | image_url: width: 750 }} 750w, {{ s.image_mobile | image_url: width: 1080 }} 1080w"
              sizes="100vw"
              alt="{{ s.title | escape }}"
              loading="lazy"
              width="1080"
              height="1440">
          {%- endif -%}
        </picture>
      {%- else -%}
      <svg viewBox="0 0 560 360" fill="none" stroke="#121212" stroke-width="1.2" aria-label="MF-25 size diagram">
        <circle cx="120" cy="280" r="55" fill="#f8f9fa"/>
        <circle cx="380" cy="280" r="55" fill="#f8f9fa"/>
        <line x1="120" y1="280" x2="220" y2="180"/>
        <line x1="220" y1="180" x2="290" y2="180"/>
        <line x1="290" y1="180" x2="380" y2="280"/>
        <line x1="220" y1="180" x2="200" y2="280"/>
        <line x1="220" y1="180" x2="220" y2="120"/>
        <line x1="220" y1="120" x2="200" y2="180"/>
        <line x1="200" y1="180" x2="180" y2="120"/>
        <text x="265" y="155" font-family="Montserrat, sans-serif" font-size="10" fill="#6B675F" text-anchor="middle">17" FRAME</text>
        <text x="490" y="60" font-family="Inter, sans-serif" font-size="10" fill="#121212" text-anchor="middle">5'3" — 7'3"</text>
        <line x1="490" y1="70" x2="490" y2="280" stroke="#FFC000" stroke-width="1" stroke-dasharray="3 3"/>
        <text x="490" y="295" font-family="Inter, sans-serif" font-size="9" fill="#6B675F" text-anchor="middle">RIDER HEIGHT</text>
        <text x="70" y="60" font-family="Inter, sans-serif" font-size="10" fill="#121212" text-anchor="middle">17"</text>
        <line x1="70" y1="70" x2="70" y2="220" stroke="#FFC000" stroke-width="1" stroke-dasharray="3 3"/>
        <text x="70" y="232" font-family="Inter, sans-serif" font-size="9" fill="#6B675F" text-anchor="middle">STANDOVER</text>
        <text x="250" y="350" font-family="Inter, sans-serif" font-size="10" fill="#121212" text-anchor="middle">44.3" WHEELBASE</text>
        <line x1="120" y1="340" x2="380" y2="340" stroke="#FFC000" stroke-width="1" stroke-dasharray="3 3"/>
      </svg>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "MF25 Stitch Size",
  "tag": "section",
  "class": "section-mf25-stitch-size",
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "Find Your Perfect Fit" },
    { "type": "textarea", "id": "subtitle", "label": "Subtitle", "default": "The step-thru design is engineered for riders between 5'3\" and 7'3\"." },
    { "type": "header", "content": "Size image" },
    { "type": "image_picker", "id": "image", "label": "Image (desktop)", "info": "Recommended: 1200x900 (4:3). If empty, falls back to the built-in diagram." },
    { "type": "image_picker", "id": "image_mobile", "label": "Image (mobile, 750x1080 recommended)", "info": "Optional. Portrait size chart for mobile. If empty, the desktop image is used on all viewports." }
  ]
}
{% endschema %}