{%- liquid
  assign s = section.settings
-%}
{% render 'mf35-stitch-styles' %}

<div class="mf35-root">
  <section class="mf35-size" style="padding-top:{{ s.padding_top }}px;padding-bottom:{{ s.padding_bottom }}px" {{ section.shopify_attributes }}>
    <div class="mf35-container">
      <div class="mf35-size-head">
        <span class="mf35-kicker">{{ s.kicker | escape }}</span>
        <h2>{{ s.heading | escape }}</h2>
        <p>{{ s.subheading | escape }}</p>
      </div>

      <div class="mf35-size-grid">
        <div class="mf35-blueprint" data-mf35-fit-host>
          <div class="mf35-blueprint-head">
            <span class="mf35-blueprint-title">{{ s.blueprint_title }}</span>
            <span class="mf35-blueprint-tag">{{ s.blueprint_tag }}</span>
          </div>

          <div class="mf35-blueprint-canvas">
            <picture>
              {%- if s.image_mobile != blank -%}
                <source media="(max-width: 768px)" srcset="{{ s.image_mobile | image_url: width: 750 }} 750w, {{ s.image_mobile | image_url: width: 1080 }} 1080w" sizes="(max-width: 768px) 100vw, 750px">
              {%- endif -%}
              {%- if s.image != blank -%}
                <img src="{{ s.image | image_url: width: 1080 }}" srcset="{{ s.image | image_url: width: 750 }} 750w, {{ s.image | image_url: width: 1080 }} 1080w, {{ s.image | image_url: width: 1440 }} 1440w" sizes="(min-width: 769px) 60vw, 100vw" alt="{{ s.heading | escape }}" loading="lazy" width="1200" height="640">
              {%- else -%}
                <img src="{{ s.image_mobile | image_url: width: 1080 }}" alt="{{ s.heading | escape }}" loading="lazy" width="1080" height="576">
              {%- endif -%}
            </picture>
          </div>

          <div class="mf35-fit-calc">
            <div class="mf35-fit-calc-head">
              <span class="mf35-fit-calc-label">{{ s.slider_label | escape }}</span>
              <span class="mf35-fit-calc-val" data-mf35-height-label>5' 6" (168 cm)</span>
            </div>
            <input
              type="range"
              class="mf35-fit-slider"
              min="59"
              max="74"
              step="1"
              value="66"
              data-mf35-height-slider
              aria-label="{{ s.slider_label | escape }}">
            <div class="mf35-fit-ticks">
              <span>4'11"</span><span>5'4"</span><span>5'8"</span><span>6'0"</span><span>6'2"</span>
            </div>
            <div class="mf35-fit-verdict" data-mf35-fit-verdict>
              <svg class="mf35-fit-verdict-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 12l2 2 4-4" stroke-linecap="round" stroke-linejoin="round"/><circle cx="12" cy="12" r="9"/></svg>
              <span><strong>Ideal Match:</strong> Upright relaxed spine with full flat-foot stops at intersections.</span>
            </div>
          </div>
        </div>

        <div class="mf35-spec-table">
          <span class="mf35-spec-table-title">{{ s.spec_table_title | escape }}</span>
          {%- for block in section.blocks -%}
            {%- if block.type == 'row' -%}
              <div class="mf35-spec-row" {{ block.shopify_attributes }}>
                <span class="mf35-spec-row-attr">{{ block.settings.attribute | escape }}</span>
                <span class="mf35-spec-row-val">{{ block.settings.value | escape }}</span>
              </div>
            {%- endif -%}
          {%- endfor -%}
          {%- if s.foot_link_text != blank -%}
            <a href="{{ s.foot_link_url | default: '#' }}" class="mf35-spec-foot-link">[ {{ s.foot_link_text | escape }} → ]</a>
          {%- endif -%}
        </div>
      </div>
    </div>
  </section>
</div>

<script>
(function(){
  var host = document.querySelector('[data-mf35-fit-host]');
  if (!host) return;
  var slider = host.querySelector('[data-mf35-height-slider]');
  var label = host.querySelector('[data-mf35-height-label]');
  var verdict = host.querySelector('[data-mf35-fit-verdict]');
  if (!slider || !label || !verdict) return;

  function updateFit(inches){
    var ft = Math.floor(inches / 12);
    var remInches = inches % 12;
    var cm = Math.round(inches * 2.54);
    label.textContent = ft + "' " + remInches + '" (' + cm + ' cm)';

    var msg = '';
    if (inches <= 62) {
      msg = '<strong>Comfort Fit:</strong> Lower saddle clamp to minimum position. Handlebars angled slightly backward for relaxed reach.';
    } else if (inches >= 72) {
      msg = '<strong>Tall Rider Setup:</strong> Extend seatpost to line 7. Stem can be raised 3 inches for zero knee interference.';
    } else {
      msg = '<strong>Ideal Match:</strong> Upright relaxed spine with full flat-foot stops at intersections.';
    }
    verdict.innerHTML = '<svg class="mf35-fit-verdict-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 12l2 2 4-4" stroke-linecap="round" stroke-linejoin="round"/><circle cx="12" cy="12" r="9"/></svg><span>' + msg + '</span>';
  }

  slider.addEventListener('input', function(){ updateFit(parseInt(slider.value, 10)); });
  updateFit(parseInt(slider.value, 10));
})();
</script>

{% schema %}
{
  "name": "MF35 Stitch Size",
  "tag": "section",
  "class": "section-mf35-stitch-size",
  "max_blocks": 16,
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "// ERGONOMIC MATRIX & FIT GUIDE" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "WILL IT FIT YOU COMFORTABLY?" },
    { "type": "textarea", "id": "subheading", "label": "Subheading",
      "default": "Adjustable saddle post (10\" travel) and tool-free quick-tilt handlebar stem ensure tailored fit for riders 4'11\" to 6'2\"." },
    { "type": "header", "content": "Blueprint schematic (left column)" },
    { "type": "text", "id": "blueprint_title", "label": "Blueprint title", "default": "CHASSIS SCHEMATIC & CLEARANCES" },
    { "type": "text", "id": "blueprint_tag", "label": "Blueprint tag (mono)", "default": "MEASUREMENTS IN INCHES / MM" },
    { "type": "image_picker", "id": "image", "label": "Schematic image (desktop, ≥769px)",
      "info": "Recommended: 1200×640 (~1.87:1). Used on tablet & desktop. If empty, falls back to the mobile image." },
    { "type": "image_picker", "id": "image_mobile", "label": "Schematic image (mobile, ≤768px)",
      "info": "Recommended: 1080×576 (~1.87:1) or any wide ratio. Used on mobile. If empty, falls back to the desktop image." },
    { "type": "text", "id": "slider_label", "label": "Height slider label", "default": "Select Your Height:" },
    { "type": "header", "content": "Spec table (right column)" },
    { "type": "text", "id": "spec_table_title", "label": "Spec table title", "default": "TECHNICAL SPECIFICATIONS TEARDOWN" },
    { "type": "text", "id": "foot_link_text", "label": "Footer link text (mono bracket)", "default": "DOWNLOAD PDF USER MANUAL & ASSEMBLY GUIDE" },
    { "type": "url", "id": "foot_link_url", "label": "Footer link URL" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 60 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 60 }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Spec row",
      "settings": [
        { "type": "text", "id": "attribute", "label": "Attribute (left)", "default": "Motor Type" },
        { "type": "text", "id": "value", "label": "Value (right)", "default": "Bafang 750W Peak (500W Continuous)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "MF35 Stitch Size",
      "blocks": [
        { "type": "row", "settings": { "attribute": "Motor Type", "value": "Bafang 750W Peak (500W Continuous)" } },
        { "type": "row", "settings": { "attribute": "Battery Chemistry", "value": "48V 14Ah (672Wh) UL-2849 Li-ion" } },
        { "type": "row", "settings": { "attribute": "Drivetrain & Gearing", "value": "Shimano Altus 7-Speed Indexed" } },
        { "type": "row", "settings": { "attribute": "Tire Specifications", "value": "Front 20\" × 3.0\" | Rear 16\" × 3.0\" Puncture-Proof" } },
        { "type": "row", "settings": { "attribute": "Braking Hardware", "value": "Triple 160mm Discs + Dual Parking Brake" } },
        { "type": "row", "settings": { "attribute": "Frame Composition", "value": "6061 Heat-Treated Aluminum Alloy" } },
        { "type": "row", "settings": { "attribute": "Total Net Weight", "value": "68 lbs (With Battery Installed)" } },
        { "type": "row", "settings": { "attribute": "Top Assist Velocity", "value": "Class 2: 20 MPH (Legal on Bike Paths)" } },
        { "type": "row", "settings": { "attribute": "Water Resistance", "value": "IPX5 Weatherproof Sealed Harness" } }
      ]
    }
  ]
}
{% endschema %}