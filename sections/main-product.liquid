{%- liquid
  assign s = section.settings
  assign has_blocks = false
  if section.blocks.size > 0
    assign has_blocks = true
  endif

  assign has_color_family = false
  if product.metafields.custom.product_family.value != blank
    if product.metafields.custom.product_family.value.members.value.size > 1
      assign has_color_family = true
    endif
  endif

  assign pdp_rating = 0
  if product.metafields.reviews.rating and product.metafields.reviews.rating.value
    assign pdp_rating = product.metafields.reviews.rating.value | times: 1.0
  endif
  assign pdp_review_count = product.metafields.reviews.rating_count | default: 0

  assign block_has_qty = false
  for b in section.blocks
    if b.type == 'quantity_selector'
      assign block_has_qty = true
    endif
  endfor
-%}





<section class="section pdp-gallery" {{ section.shopify_attributes }}>
  <div class="container pdp__grid">
    <div class="pdp__media">
      {% render 'product-media' %}
    </div>

    <div class="pdp__info">
      {%- if has_blocks -%}
        {%- comment -%}
          BLOCKS-DRIVEN MODE — each block in section.blocks (respecting
          block_order) renders its own fragment. variant_picker +
          quantity_selector are captured and emitted INSIDE the
          buy_buttons form, so they stay one form regardless of block
          order. rating, color-family, stock, finance are auto-injected
          via section settings to preserve current display.
        {%- endcomment -%}

        {%- for block in section.blocks -%}
          {%- case block.type -%}

            {%- when 'vendor' -%}
              <div class="pdp__vendor" {{ block.shopify_attributes }}>
                {{ product.vendor }}
              </div>

            {%- when 'title' -%}
              <h1 class="pdp__title{% if block.settings.font_size == 'small' %} pdp__title--sm{% elsif block.settings.font_size == 'large' %} pdp__title--lg{% endif %}" {{ block.shopify_attributes }}>
                {{ product.title }}
              </h1>

            {%- when 'price' -%}
              {% render 'price' %}

            {%- when 'caption' -%}
              <div class="pdp__caption" {{ block.shopify_attributes }}>
                {{ product.selected_or_first_available_variant.sku | default: product.type }}
              </div>

            {%- when 'description' -%}
              <div class="pdp__description" {{ block.shopify_attributes }}>
                {{ product.description }}
              </div>

            {%- when 'share' -%}
              <div class="pdp__share" {{ block.shopify_attributes }}>
                <a href="https://www.facebook.com/sharer/sharer.php?u={{ shop.url | append: product.url | url_encode }}" target="_blank" rel="noopener">Share</a>
              </div>

            {%- when 'variant_picker' -%}
              {%- if product.options.size > 0 -%}
                <div class="pdp__form pdp__variants" form="pdp__form">
                  <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" class="product-variant-id" form="pdp__form">
                  {%- for option in product.options_with_values -%}
                    {%- if has_color_family and option.name == 'Color' -%}
                      {%- continue -%}
                    {%- endif -%}
                    <div class="pdp__option" {{ block.shopify_attributes }}>
                      <label class="pdp__option-label">
                        {{ option.name }}:
                        <strong data-selected-option="{{ forloop.index0 }}">{{ option.selected_value }}</strong>
                      </label>
                      {%- if option.name == 'Color' -%}
                        <div class="pdp__swatches">
                          {%- for value in option.values -%}
                            {%- assign variant = nil -%}
                            {%- for v in product.variants -%}
                              {%- if v.option1 == value -%}
                                {%- assign variant = v -%}
                                {%- break -%}
                              {%- endif -%}
                            {%- endfor -%}
                            {%- assign swatch_hex = blank -%}
                            {%- if variant and variant.metafields.custom.color_hex != blank -%}
                              {%- assign swatch_hex = variant.metafields.custom.color_hex -%}
                            {%- else -%}
                              {%- assign swatch_name = value | downcase | handleize -%}
                              {%- case swatch_name -%}
                                {%- when 'red' -%}{%- assign swatch_hex = '#d32f2f' -%}
                                {%- when 'crimson' -%}{%- assign swatch_hex = '#dc143c' -%}
                                {%- when 'orange' -%}{%- assign swatch_hex = '#ff6b1a' -%}
                                {%- when 'burning-orange' -%}{%- assign swatch_hex = '#ff5722' -%}
                                {%- when 'vibrant-orange' -%}{%- assign swatch_hex = '#ff6f00' -%}
                                {%- when 'yellow' -%}{%- assign swatch_hex = '#fbc02d' -%}
                                {%- when 'gold' -%}{%- assign swatch_hex = '#d4af37' -%}
                                {%- when 'green' -%}{%- assign swatch_hex = '#388e3c' -%}
                                {%- when 'lime' -%}{%- assign swatch_hex = '#9ccc65' -%}
                                {%- when 'pangea-green' -%}{%- assign swatch_hex = '#2e7d32' -%}
                                {%- when 'teal' -%}{%- assign swatch_hex = '#00897b' -%}
                                {%- when 'cyan' -%}{%- assign swatch_hex = '#00acc1' -%}
                                {%- when 'blue' -%}{%- assign swatch_hex = '#1976d2' -%}
                                {%- when 'navy' -%}{%- assign swatch_hex = '#0d2c54' -%}
                                {%- when 'neptune-blue' -%}{%- assign swatch_hex = '#1e3a5f' -%}
                                {%- when 'purple' -%}{%- assign swatch_hex = '#7b1fa2' -%}
                                {%- when 'pink' -%}{%- assign swatch_hex = '#d81b60' -%}
                                {%- when 'brown' -%}{%- assign swatch_hex = '#5d4037' -%}
                                {%- when 'beige' -%}{%- assign swatch_hex = '#d7c3a5' -%}
                                {%- when 'tan' -%}{%- assign swatch_hex = '#c9a87c' -%}
                                {%- when 'black' -%}{%- assign swatch_hex = '#1a1a1a' -%}
                                {%- when 'white' -%}{%- assign swatch_hex = '#ffffff' -%}
                                {%- when 'gray', 'grey' -%}{%- assign swatch_hex = '#6b6b6b' -%}
                                {%- when 'brooklyn-gray' -%}{%- assign swatch_hex = '#6b6b6b' -%}
                                {%- when 'silver' -%}{%- assign swatch_hex = '#c0c0c0' -%}
                              {%- endcase -%}
                            {%- endif -%}
                            {%- if swatch_hex == blank -%}{%- assign swatch_hex = '#cccccc' -%}{%- endif -%}
                            <label class="swatch" data-swatch="{{ value | handleize }}">
                              <input type="radio" name="options[{{ option.name | downcase }}]" value="{{ value }}" {% if option.selected_value == value %}checked{% endif %} data-variant-id="{{ variant.id | default: '' }}" data-option-index="{{ forloop.index0 }}">
                              <span class="swatch__color" style="background:{{ swatch_hex }}{% if swatch_hex == '#ffffff' %};border:1px solid #ccc{% endif %}"></span>
                              <span class="swatch__label">{{ value }}</span>
                            </label>
                          {%- endfor -%}
                        </div>
                      {%- else -%}
                        <select name="options[{{ option.name | downcase }}]" class="pdp__select" data-option-index="{{ forloop.index0 }}">
                          {%- for value in option.values -%}
                            <option value="{{ value }}" {% if option.selected_value == value %}selected{% endif %}>{{ value }}</option>
                          {%- endfor -%}
                        </select>
                      {%- endif -%}
                    </div>
                  {%- endfor -%}
                </div>
              {%- endif -%}

            {%- when 'quantity_selector' -%}
              <div class="pdp__qty" {{ block.shopify_attributes }}>
                <button type="button" data-qty="dec" aria-label="Decrease">{% render 'icon', icon: 'minus' %}</button>
                <input type="number" name="quantity" value="1" min="1" data-qty-input form="pdp__form">
                <button type="button" data-qty="inc" aria-label="Increase">{% render 'icon', icon: 'plus' %}</button>
              </div>

            {%- when 'buy_buttons' -%}
              <div class="pdp__buy" {{ block.shopify_attributes }}>
                {%- form 'product', product, id: 'pdp__form', class: 'pdp__form' -%}
                  <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" class="product-variant-id">
                  <div class="pdp__qty-row">
                    {%- unless block_has_qty -%}
                    <div class="pdp__qty">
                      <button type="button" data-qty="dec" aria-label="Decrease">{% render 'icon', icon: 'minus' %}</button>
                      <input type="number" name="quantity" value="1" min="1" data-qty-input>
                      <button type="button" data-qty="inc" aria-label="Increase">{% render 'icon', icon: 'plus' %}</button>
                    </div>
                    {%- endunless -%}
                    <button type="submit" name="add" class="btn btn--primary pdp__cta"{% unless product.available %} disabled{% endunless %}>
                      {%- if product.available -%}
                        Add to Cart <span class="pdp__cta-price">&mdash; {{ product.price | money }}</span>
                      {%- else -%}
                        Sold Out
                      {%- endif -%}
                    </button>
                  </div>
                  {%- if product.available -%}
                    <div class="pdp__dynamic-checkout">
                      {{ form | payment_button }}
                    </div>
                  {%- endif -%}
                {%- endform -%}
              </div>

            {%- when 'inventory' -%}
              <div class="pdp__stock" {{ block.shopify_attributes }}>
                <span class="pdp__stock-status">
                  {% render 'icon', icon: 'check', size: 14 %}
                  <strong>{% if product.available %}In stock{% else %}Sold out{% endif %}</strong>
                </span>
                {%- if product.available and block.settings.show_inventory_quantity -%}
                  <span class="pdp__stock-detail">{{ product.selected_or_first_available_variant.inventory_quantity | default: 0 }} available &mdash; Ships within 2 business days</span>
                {%- endif -%}
              </div>

            {%- when 'custom_liquid' -%}
              <div class="pdp__custom-liquid" style="padding-top:{{ block.settings.padding_top }}px;padding-bottom:{{ block.settings.padding_bottom }}px" {{ block.shopify_attributes }}>
                {{ block.settings.custom_liquid }}
              </div>

            {%- when 'text' -%}
              <div class="pdp__text pdp__text--{{ block.settings.text_style }}" {{ block.shopify_attributes }}>
                {{ block.settings.text }}
              </div>

            {%- when 'icon_with_text' -%}
              <div class="pdp__extra" {{ block.shopify_attributes }}>
                <span class="pdp__extra-icon">
                  {%- case block.settings.icon -%}
                    {%- when 'truck' -%}{% render 'icon', icon: 'truck', size: 20 %}
                    {%- when 'shield' -%}{% render 'icon', icon: 'shield', size: 20 %}
                    {%- when 'phone' -%}{% render 'icon', icon: 'phone', size: 20 %}
                    {%- when 'calendar' -%}{% render 'icon', icon: 'calendar', size: 20 %}
                    {%- else -%}{% render 'icon', icon: 'check', size: 20 %}
                  {%- endcase -%}
                </span>
                <strong>{{ block.settings.heading }}</strong>
                <span class="pdp__extra-sub">{{ block.settings.subtext }}</span>
              </div>

            {%- when 'collapsible_tab', 'collapsible-row' -%}
              <details class="pdp__collapsible" {{ block.shopify_attributes }}>
                <summary>
                  {%- case block.settings.icon -%}
                    {%- when 'truck' -%}{% render 'icon', icon: 'truck', size: 16 %}
                    {%- when 'shield' -%}{% render 'icon', icon: 'shield', size: 16 %}
                    {%- when 'phone' -%}{% render 'icon', icon: 'phone', size: 16 %}
                    {%- when 'calendar' -%}{% render 'icon', icon: 'calendar', size: 16 %}
                    {%- else -%}{% render 'icon', icon: 'check', size: 16 %}
                  {%- endcase -%}
                  {{ block.settings.heading }}
                </summary>
                <div class="pdp__collapsible-content">{{ block.settings.content }}</div>
              </details>

            {%- when 'impact-accessories' -%}
              {%- if block.settings.accessories_product != blank -%}
                {%- assign acco = all_products[block.settings.accessories_product] -%}
                {%- if acco != empty -%}
                  <div class="pdp__accessory" {{ block.shopify_attributes }}>
                    <input type="checkbox" name="accessories[]" value="{{ acco.selected_or_first_available_variant.id }}" id="acc-{{ block.id }}" {% if block.settings.accessories_is_checed == 'yes' %}checked{% endif %}>
                    <label for="acc-{{ block.id }}">
                      {% if acco.featured_image %}<img src="{{ acco.featured_image | image_url: width: 64 }}" alt="{{ acco.title | escape }}" width="64" height="64">{% endif %}
                      <span class="pdp__accessory-name">{{ acco.title }}</span>
                      <span class="pdp__accessory-price">{{ acco.price | money }}</span>
                    </label>
                  </div>
                {%- endif -%}
              {%- endif -%}

            {%- when 'extra' -%}
              <div class="pdp__extra" {{ block.shopify_attributes }}>
                <span class="pdp__extra-icon">
                  {%- case block.settings.icon -%}
                    {%- when 'truck' -%}{% render 'icon', icon: 'truck', size: 20 %}
                    {%- when 'shield' -%}{% render 'icon', icon: 'shield', size: 20 %}
                    {%- when 'calendar' -%}{% render 'icon', icon: 'calendar', size: 20 %}
                    {%- when 'phone' -%}{% render 'icon', icon: 'phone', size: 20 %}
                    {%- else -%}{% render 'icon', icon: 'check', size: 20 %}
                  {%- endcase -%}
                </span>
                <strong>{{ block.settings.title }}</strong>
                <span class="pdp__extra-sub">{{ block.settings.subtitle }}</span>
              </div>

          {%- endcase -%}
        {%- endfor -%}

        {%- comment -%}
          AUTO-INJECTED elements (not blocks) — driven by section settings,
          preserved so current display is not broken.
        {%- endcomment -%}

        {%- assign pdp_rating = 0 -%}
        {%- if product.metafields.reviews.rating and product.metafields.reviews.rating.value -%}
          {%- assign pdp_rating = product.metafields.reviews.rating.value | times: 1.0 -%}
        {%- endif -%}
        {%- assign pdp_review_count = product.metafields.reviews.rating_count | default: 0 -%}
        {%- if pdp_rating > 0 -%}
          <div class="pdp__rating">
            {% render 'stars', rating: pdp_rating %}
            <span class="pdp__rating-text">{{ pdp_rating }} ({{ pdp_review_count }} reviews)</span>
          </div>
        {%- else -%}
          <div class="pdp__rating pdp__rating--empty">
            <span class="pdp__rating-text">No reviews yet</span>
          </div>
        {%- endif -%}

        {%- assign has_color_family = false -%}
        {%- if product.metafields.custom.product_family.value != blank -%}
          {%- if product.metafields.custom.product_family.value.members.value.size > 1 -%}
            {%- assign has_color_family = true -%}
          {%- endif -%}
        {%- endif -%}
        {%- if has_color_family -%}
          {% render 'pdp-color-family' %}
        {%- endif -%}

        {%- if s.show_stock -%}
          <div class="pdp__stock">
            <span class="pdp__stock-status">
              {% render 'icon', icon: 'check', size: 14 %}
              <strong>In stock</strong>
            </span>
            <span class="pdp__stock-detail">{{ s.stock_count | default: 24 }} available &mdash; Ships within 2 business days</span>
          </div>
        {%- endif -%}

        {%- if s.show_finance -%}
          <div class="pdp__finance">
            Or <strong>4 payments of {{ product.price | divided_by: 4 | money }}</strong>
            &mdash; <a href="{{ s.finance_link | default: '#' }}">{{ s.finance_label | default: 'Affirm financing' }}</a>
          </div>
        {%- endif -%}

      {%- else -%}
        {%- comment -%}
          FALLBACK — no blocks declared in the template JSON. Preserve the
          original hardcoded buy box exactly as before.
        {%- endcomment -%}
        <div class="pdp__category">{{ product.type | default: 'Electric Trike' }}</div>
        <h1 class="pdp__title">{{ product.title }}</h1>

        {%- assign pdp_rating = 0 -%}
        {%- if product.metafields.reviews.rating and product.metafields.reviews.rating.value -%}
          {%- assign pdp_rating = product.metafields.reviews.rating.value | times: 1.0 -%}
        {%- endif -%}
        {%- assign pdp_review_count = product.metafields.reviews.rating_count | default: 0 -%}
        {%- if pdp_rating > 0 -%}
          <div class="pdp__rating">
            {% render 'stars', rating: pdp_rating %}
            <span class="pdp__rating-text">{{ pdp_rating }} ({{ pdp_review_count }} reviews)</span>
          </div>
        {%- else -%}
          <div class="pdp__rating pdp__rating--empty">
            <span class="pdp__rating-text">No reviews yet</span>
          </div>
        {%- endif -%}

        {% render 'price' %}

        {%- if s.show_stock -%}
          <div class="pdp__stock">
            <span class="pdp__stock-status">
              {% render 'icon', icon: 'check', size: 14 %}
              <strong>In stock</strong>
            </span>
            <span class="pdp__stock-detail">{{ s.stock_count | default: 24 }} available &mdash; Ships within 2 business days</span>
          </div>
        {%- endif -%}

        {%- assign has_color_family = false -%}
        {%- if product.metafields.custom.product_family.value != blank -%}
          {%- if product.metafields.custom.product_family.value.members.value.size > 1 -%}
            {%- assign has_color_family = true -%}
          {%- endif -%}
        {%- endif -%}
        {%- if has_color_family -%}
          {% render 'pdp-color-family' %}
        {%- endif -%}

        {%- if product.options.size > 0 -%}
          {%- form 'product', product, id: 'pdp__form', class: 'pdp__form' -%}
            <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" class="product-variant-id">
            {%- for option in product.options_with_values -%}
              {%- if has_color_family and option.name == 'Color' -%}
                {%- continue -%}
              {%- endif -%}
              <div class="pdp__option">
                <label class="pdp__option-label">
                  {{ option.name }}:
                  <strong data-selected-option="{{ forloop.index0 }}">{{ option.selected_value }}</strong>
                </label>
                {%- if option.name == 'Color' -%}
                  <div class="pdp__swatches">
                    {%- for value in option.values -%}
                      {%- assign variant = nil -%}
                      {%- for v in product.variants -%}
                        {%- if v.option1 == value -%}
                          {%- assign variant = v -%}
                          {%- break -%}
                        {%- endif -%}
                      {%- endfor -%}
                      {%- assign swatch_hex = blank -%}
                      {%- if variant and variant.metafields.custom.color_hex != blank -%}
                        {%- assign swatch_hex = variant.metafields.custom.color_hex -%}
                      {%- else -%}
                        {%- assign swatch_name = value | downcase | handleize -%}
                        {%- case swatch_name -%}
                          {%- when 'red' -%}{%- assign swatch_hex = '#d32f2f' -%}
                          {%- when 'crimson' -%}{%- assign swatch_hex = '#dc143c' -%}
                          {%- when 'orange' -%}{%- assign swatch_hex = '#ff6b1a' -%}
                          {%- when 'burning-orange' -%}{%- assign swatch_hex = '#ff5722' -%}
                          {%- when 'vibrant-orange' -%}{%- assign swatch_hex = '#ff6f00' -%}
                          {%- when 'yellow' -%}{%- assign swatch_hex = '#fbc02d' -%}
                          {%- when 'gold' -%}{%- assign swatch_hex = '#d4af37' -%}
                          {%- when 'green' -%}{%- assign swatch_hex = '#388e3c' -%}
                          {%- when 'lime' -%}{%- assign swatch_hex = '#9ccc65' -%}
                          {%- when 'pangea-green' -%}{%- assign swatch_hex = '#2e7d32' -%}
                          {%- when 'teal' -%}{%- assign swatch_hex = '#00897b' -%}
                          {%- when 'cyan' -%}{%- assign swatch_hex = '#00acc1' -%}
                          {%- when 'blue' -%}{%- assign swatch_hex = '#1976d2' -%}
                          {%- when 'navy' -%}{%- assign swatch_hex = '#0d2c54' -%}
                          {%- when 'neptune-blue' -%}{%- assign swatch_hex = '#1e3a5f' -%}
                          {%- when 'purple' -%}{%- assign swatch_hex = '#7b1fa2' -%}
                          {%- when 'pink' -%}{%- assign swatch_hex = '#d81b60' -%}
                          {%- when 'brown' -%}{%- assign swatch_hex = '#5d4037' -%}
                          {%- when 'beige' -%}{%- assign swatch_hex = '#d7c3a5' -%}
                          {%- when 'tan' -%}{%- assign swatch_hex = '#c9a87c' -%}
                          {%- when 'black' -%}{%- assign swatch_hex = '#1a1a1a' -%}
                          {%- when 'white' -%}{%- assign swatch_hex = '#ffffff' -%}
                          {%- when 'gray', 'grey' -%}{%- assign swatch_hex = '#6b6b6b' -%}
                          {%- when 'brooklyn-gray' -%}{%- assign swatch_hex = '#6b6b6b' -%}
                          {%- when 'silver' -%}{%- assign swatch_hex = '#c0c0c0' -%}
                        {%- endcase -%}
                      {%- endif -%}
                      {%- if swatch_hex == blank -%}{%- assign swatch_hex = '#cccccc' -%}{%- endif -%}
                      <label class="swatch" data-swatch="{{ value | handleize }}">
                        <input type="radio" name="options[{{ option.name | downcase }}]" value="{{ value }}" {% if option.selected_value == value %}checked{% endif %} data-variant-id="{{ variant.id | default: '' }}" data-option-index="{{ forloop.index0 }}">
                        <span class="swatch__color" style="background:{{ swatch_hex }}{% if swatch_hex == '#ffffff' %};border:1px solid #ccc{% endif %}"></span>
                        <span class="swatch__label">{{ value }}</span>
                      </label>
                    {%- endfor -%}
                  </div>
                {%- else -%}
                  <select name="options[{{ option.name | downcase }}]" class="pdp__select" data-option-index="{{ forloop.index0 }}">
                    {%- for value in option.values -%}
                      <option value="{{ value }}" {% if option.selected_value == value %}selected{% endif %}>{{ value }}</option>
                    {%- endfor -%}
                  </select>
                {%- endif -%}
              </div>
            {%- endfor -%}

            <div class="pdp__qty-row">
              <div class="pdp__qty">
                <button type="button" data-qty="dec" aria-label="Decrease">{% render 'icon', icon: 'minus' %}</button>
                <input type="number" name="quantity" value="1" min="1" data-qty-input>
                <button type="button" data-qty="inc" aria-label="Increase">{% render 'icon', icon: 'plus' %}</button>
              </div>
              <button type="submit" name="add" class="btn btn--primary pdp__cta"{% unless product.available %} disabled{% endunless %}>
                {%- if product.available -%}
                  Add to Cart <span class="pdp__cta-price">&mdash; {{ product.price | money }}</span>
                {%- else -%}
                  Sold Out
                {%- endif -%}
              </button>
            </div>
            {%- if product.available -%}
              <div class="pdp__dynamic-checkout">
                {{ form | payment_button }}
              </div>
            {%- endif -%}
          {%- endform -%}
        {%- else -%}
          {%- form 'product', product, id: 'pdp__form', class: 'pdp__form' -%}
            <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" class="product-variant-id">
            <div class="pdp__qty-row">
              <div class="pdp__qty">
                <button type="button" data-qty="dec">{% render 'icon', icon: 'minus' %}</button>
                <input type="number" name="quantity" value="1" min="1">
                <button type="button" data-qty="inc">{% render 'icon', icon: 'plus' %}</button>
              </div>
              <button type="submit" class="btn btn--primary pdp__cta">Add to Cart <span class="pdp__cta-price">&mdash; {{ product.price | money }}</span></button>
            </div>
            {%- if product.available -%}
              <div class="pdp__dynamic-checkout">
                {{ form | payment_button }}
              </div>
            {%- endif -%}
          {%- endform -%}
        {%- endif -%}

        {%- if s.show_finance -%}
          <div class="pdp__finance">
            Or <strong>4 payments of {{ product.price | divided_by: 4 | money }}</strong>
            &mdash; <a href="{{ s.finance_link | default: '#' }}">{{ s.finance_label | default: 'Affirm financing' }}</a>
          </div>
        {%- endif -%}

        {%- if s.show_extras -%}
          <div class="pdp__extras">
            {%- for block in section.blocks -%}
              {%- if block.type == 'extra' -%}
                <div class="pdp__extra" {{ block.shopify_attributes }}>
                  <span class="pdp__extra-icon">
                    {%- case block.settings.icon -%}
                      {%- when 'truck' -%}{% render 'icon', icon: 'truck', size: 20 %}
                      {%- when 'shield' -%}{% render 'icon', icon: 'shield', size: 20 %}
                      {%- when 'calendar' -%}{% render 'icon', icon: 'calendar', size: 20 %}
                      {%- when 'phone' -%}{% render 'icon', icon: 'phone', size: 20 %}
                      {%- else -%}{% render 'icon', icon: 'check', size: 20 %}
                    {%- endcase -%}
                  </span>
                  <strong>{{ block.settings.title }}</strong>
                  <span class="pdp__extra-sub">{{ block.settings.subtitle }}</span>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      {%- endif -%}
    </div>
  </div>
</section>

