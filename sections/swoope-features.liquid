{% render 'swoope-styles' %}

{%- liquid
  assign s = section.settings
  assign block_count = 0
  for block in section.blocks
    assign block_count = block_count | plus: 1
  endfor
-%}

<style>
.sw-feat{background:var(--sw-surface-0);border-top:1px solid var(--sw-surface-highest);padding:64px 0;box-sizing:border-box}
.sw-feat-head{margin-bottom:24px}
.sw-feat-head h2{font-family:var(--sw-display);font-weight:700;font-size:clamp(28px,3.5vw,40px);letter-spacing:-0.02em;color:var(--sw-on-surface);margin:0}
/* 2-col grid, 4 rows total (8 wide tiles). Each row ~240px on a 1080-tall
   viewport so 4 rows + gaps + padding fit in one screen. */
.sw-feat-grid{display:grid;grid-template-columns:repeat(2,1fr);grid-auto-rows:clamp(200px,calc((100vh - 228px) / 4),320px);gap:12px}
.sw-feat-tile{position:relative;overflow:hidden;border-radius:12px;background:var(--sw-surface-low);border:1px solid rgba(255,255,255,0.06)}
.sw-feat-tile img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block;transition:transform .4s}
.sw-feat-tile:hover img{transform:scale(1.04)}
.sw-feat-tile::after{content:"";position:absolute;inset:0;background:linear-gradient(to top,rgba(10,10,10,0.88) 0%,rgba(10,10,10,0.5) 35%,rgba(10,10,10,0.15) 70%,transparent 100%);z-index:1;pointer-events:none}
.sw-feat-overlay{position:absolute;left:0;right:0;bottom:0;z-index:2;padding:24px 28px;display:flex;flex-direction:column;justify-content:flex-end;gap:18px}
.sw-feat-pair{display:flex;flex-direction:column;gap:4px}
.sw-feat-value{font-family:var(--sw-mono);font-size:clamp(18px,2vw,26px);font-weight:700;line-height:1.2;color:var(--sw-on-surface);margin:0;letter-spacing:-0.01em}
.sw-feat-value[data-accent="lime"]{color:var(--sw-lime)}
.sw-feat-label{font-family:var(--sw-body);font-size:14px;font-weight:500;line-height:1.35;color:rgba(255,255,255,0.85);margin:0}
@media (max-width:960px){
  .sw-feat-grid{display:flex;flex-direction:column;gap:12px}
  .sw-feat-tile{flex:0 0 auto;aspect-ratio:16/9}
}
</style>

<section class="sw-feat" style="padding-top:{{ s.padding_top | default: 64 }}px;padding-bottom:{{ s.padding_bottom | default: 64 }}px" {{ section.shopify_attributes }}>
  <div class="sw-container">
    {%- if s.title != blank -%}
      <div class="sw-feat-head">
        <h2>{{ s.title | escape }}</h2>
      </div>
    {%- endif -%}

    {%- if block_count > 0 -%}
      <div class="sw-feat-grid">
        {%- for block in section.blocks -%}
          {%- if block.type == 'tile' -%}
            <div class="sw-feat-tile" {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}
                <img src="{{ block.settings.image | image_url: width: 1200 }}" alt="{{ block.settings.label_1 | escape }}" loading="lazy" width="1200" height="675">
              {%- endif -%}
              <div class="sw-feat-overlay">
                {%- if block.settings.value_1 != blank -%}
                  <div class="sw-feat-pair">
                    <p class="sw-feat-value"{% if block.settings.value_1_accent %} data-accent="lime"{% endif %}>{{ block.settings.value_1 | escape }}</p>
                    {%- if block.settings.label_1 != blank -%}
                      <p class="sw-feat-label">{{ block.settings.label_1 | escape }}</p>
                    {%- endif -%}
                  </div>
                {%- endif -%}
                {%- if block.settings.value_2 != blank -%}
                  <div class="sw-feat-pair">
                    <p class="sw-feat-value"{% if block.settings.value_2_accent %} data-accent="lime"{% endif %}>{{ block.settings.value_2 | escape }}</p>
                    {%- if block.settings.label_2 != blank -%}
                      <p class="sw-feat-label">{{ block.settings.label_2 | escape }}</p>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "SWOOPE Features",
  "tag": "section",
  "class": "section-swoope-features",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading (optional)",
      "info": "Leave blank to render the feature grid without a heading." },
    { "type": "header", "content": "Section spacing" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Feature tile",
      "limit": 8,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Tile image",
          "info": "All tiles render ~600×240px on desktop → upload at 1200×480 (5:2) for crisp 2x. object-fit:cover crops so loose aspect is fine. A wider source (e.g. 1600×600) also works." },
        { "type": "header", "content": "Primary value (required for visible tile)" },
        { "type": "text", "id": "value_1", "label": "Value", "default": "80 HP" },
        { "type": "checkbox", "id": "value_1_accent", "label": "Value in Electric Lime", "default": false },
        { "type": "text", "id": "label_1", "label": "Label (description under value)", "default": "Peak Power" },
        { "type": "header", "content": "Secondary value (for combined tiles — leave blank for single-spec tiles)" },
        { "type": "text", "id": "value_2", "label": "Value", "default": "" },
        { "type": "checkbox", "id": "value_2_accent", "label": "Value in Electric Lime", "default": false },
        { "type": "text", "id": "label_2", "label": "Label", "default": "" }
      ]
    }
  ],
  "presets": [
    {
      "name": "SWOOPE Features",
      "blocks": [
        { "type": "tile", "settings": {
          "value_1": "4160W", "value_1_accent": true, "label_1": "Mid-Drive Motor"
        } },
        { "type": "tile", "settings": {
          "value_1": "Max Speed 45MPH", "value_1_accent": true, "label_1": ""
        } },
        { "type": "tile", "settings": {
          "value_1": "Programmable Far-Driver Controller", "label_1": "",
          "value_2": "Magnetic Emergency Switch", "label_2": ""
        } },
        { "type": "tile", "settings": {
          "value_1": "Heavy-duty Hydraulic Brakes", "label_1": "",
          "value_2": "Hydraulic Front Fork & Nitrogen Rear Shock", "label_2": ""
        } },
        { "type": "tile", "settings": {
          "value_1": "52V 26Ah", "value_1_accent": true, "label_1": "Large Battery"
        } },
        { "type": "tile", "settings": {
          "value_1": "50 Miles", "value_1_accent": true, "label_1": ""
        } },
        { "type": "tile", "settings": {
          "value_1": "", "label_1": ""
        } },
        { "type": "tile", "settings": {
          "value_1": "", "label_1": ""
        } }
      ]
    }
  ]
}
{% endschema %}