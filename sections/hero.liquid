{%- liquid
  assign s = section.settings
  assign height_class = 'hero--' | append: s.height
-%}
<style>
  .hero__bg picture, .hero__bg picture img{width:100%;height:100%;object-fit:cover;display:block}
  @media (max-width:990px){
    .hero{min-height:0;padding:0 !important}
    .hero--compact,.hero--medium,.hero--tall{min-height:0}
    .hero__bg{position:relative;aspect-ratio:750/1080;height:auto}
    .hero__bg img,.hero__bg picture img{object-fit:cover}
    .hero__content{position:absolute;inset:0;min-height:0;display:flex;align-items:flex-end;padding:24px 20px 32px}
  }
</style>

<section class="hero {{ height_class }}" aria-label="Hero" {{ section.shopify_attributes }} style="background: {{ s.bg_color | default: 'transparent' }}">
  <div class="hero__bg">
    {%- if s.image_mobile != blank or s.image != blank -%}
      <picture>
        {%- if s.image_mobile != blank -%}
          <source
            media="(max-width: 768px)"
            srcset="{{ s.image_mobile | image_url: width: 360 }} 360w, {{ s.image_mobile | image_url: width: 375 }} 375w, {{ s.image_mobile | image_url: width: 640 }} 640w, {{ s.image_mobile | image_url: width: 750 }} 750w, {{ s.image_mobile | image_url: width: 1080 }} 1080w"
            sizes="100vw">
        {%- endif -%}
        {%- if s.image != blank -%}
          <img src="{{ s.image | image_url: width: 1600 }}"
               srcset="{{ s.image | image_url: width: 800 }} 800w, {{ s.image | image_url: width: 1200 }} 1200w, {{ s.image | image_url: width: 1600 }} 1600w, {{ s.image | image_url: width: 2000 }} 2000w"
               sizes="100vw"
               alt="{{ s.image.alt | default: 'MaxFoot family riding electric trike' | escape }}"
               loading="eager"
               width="1600"
               height="900">
        {%- else -%}
          <img src="{{ s.image_mobile | image_url: width: 750 }}"
               srcset="{{ s.image_mobile | image_url: width: 360 }} 360w, {{ s.image_mobile | image_url: width: 375 }} 375w, {{ s.image_mobile | image_url: width: 640 }} 640w, {{ s.image_mobile | image_url: width: 750 }} 750w, {{ s.image_mobile | image_url: width: 1080 }} 1080w"
               sizes="100vw"
               alt="{{ s.image_mobile.alt | default: 'MaxFoot family riding electric trike' | escape }}"
               loading="eager"
               width="750"
               height="1080">
        {%- endif -%}
      </picture>
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg hero__bg--placeholder' }}
    {%- endif -%}
  </div>

  {%- if s.badge_text != blank -%}
    <div class="hero__badge">{{ s.badge_text }}</div>
  {%- endif -%}

  <div class="container hero__content">
    <div class="hero__copy">
      {%- if s.eyebrow != blank -%}
        <span class="hero__eyebrow">{{ s.eyebrow }}</span>
      {%- endif -%}
      <h1 class="hero__title">
        {%- if s.title != blank -%}
          {{ s.title }}
        {%- else -%}
          Built for the <em>ride home.</em>
        {%- endif -%}
      </h1>
      {%- if s.subtitle != blank -%}
        <p class="hero__sub">{{ s.subtitle }}</p>
      {%- else -%}
        <p class="hero__sub">Foldable electric trikes built for the whole family. UL-certified, US-shipping, 14-day trial, 2-year warranty.</p>
      {%- endif -%}
      <div class="hero__cta">
        {%- if s.button_text != blank -%}
          <a href="{{ s.button_link | default: '/collections/all' }}" class="btn btn--primary btn--lg">
            {{ s.button_text }}
            {% render 'icon', icon: 'arrow-right' %}
          </a>
        {%- endif -%}
        {%- if s.button2_text != blank -%}
          <a href="{{ s.button2_link | default: '/collections/electric-trikes' }}" class="btn btn--ghost btn--lg">{{ s.button2_text }}</a>
        {%- endif -%}
      </div>
      {%- if s.show_urgency -%}
        <div class="hero__urgency">
          {% render 'icon', icon: 'truck', size: 16 %}
          <span>{{ s.urgency_text | default: 'Ships from US warehouse — free 2-day in 48 states' }}</span>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "tag": "section",
  "class": "section-hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "New for 2026"
    },
    {
      "type": "richtext",
      "id": "title",
      "label": "Title (use <em> for highlight)",
      "default": "<p>Built for the <em>ride home.</em></p>"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Foldable electric trikes built for the whole family. UL-certified, US-shipping, 14-day trial, 2-year warranty."
    },
    {
      "type": "header",
      "content": "Primary CTA"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Shop Electric Trikes"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Secondary CTA"
    },
    {
      "type": "text",
      "id": "button2_text",
      "label": "Button text",
      "default": "Compare Models"
    },
    {
      "type": "url",
      "id": "button2_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Hero image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image (desktop)"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Image (mobile, 750×1080 recommended)",
      "info": "Optional. Recommended size: 750×1080 (portrait, 2x retina for 375 CSS-px viewports). If empty, the desktop image is used on all viewports."
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge text (overlay)",
      "default": "FREE 14-DAY TRIAL"
    },
    {
      "type": "header",
      "content": "Urgency line"
    },
    {
      "type": "checkbox",
      "id": "show_urgency",
      "label": "Show urgency line",
      "default": true
    },
    {
      "type": "text",
      "id": "urgency_text",
      "label": "Urgency text",
      "default": "Ships from US warehouse - free 2-day in 48 states"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Section height",
      "options": [
        { "value": "compact", "label": "Compact (480px)" },
        { "value": "medium", "label": "Medium (640px)" },
        { "value": "tall", "label": "Tall (720px)" }
      ],
      "default": "medium"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color (behind image if no image)",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}
