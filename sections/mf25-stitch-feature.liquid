{%- liquid
  assign s = section.settings
  assign desktop_layout = s.desktop_layout | default: 'image_right'
-%}
{% render 'mf25-stitch-styles' %}

<section class="mf25-feat{% if desktop_layout == 'image_left' %} mf25-feat--img-left{% else %} mf25-feat--img-right{% endif %}" style="padding-top:{{ s.padding_top }}px;padding-bottom:{{ s.padding_bottom }}px" {{ section.shopify_attributes }}>
  <div class="container">
    <div class="mf25-feat-row">
      <div class="mf25-feat-img">
        {%- if s.image != blank -%}
          <img src="{{ s.image | image_url: width: 1200 }}" alt="{{ s.title | escape }}" loading="lazy" width="1200" height="900">
        {%- else -%}
          <img src="https://images.unsplash.com/photo-1532298229144-0ec0c57515c7?w=1200&h=900&fit=crop" alt="" loading="lazy" width="1200" height="900">
        {%- endif -%}
      </div>
      <div class="mf25-feat-copy">
        {%- if s.eyebrow != blank -%}
          <span class="mf25-feat-eyebrow">{{ s.eyebrow }}</span>
        {%- endif -%}
        <h2>{{ s.title }}</h2>
        <div class="mf25-feat-body">{{ s.body }}</div>
      </div>
    </div>
  </div>
</section>

{% schema %}{"name": "MF25 Stitch Feature", "tag": "section", "class": "section-mf25-stitch-feature", "settings": [{"type": "select", "id": "desktop_layout", "label": "Desktop layout (image position)", "options": [{"value": "image_right", "label": "Image right (copy on left)"}, {"value": "image_left", "label": "Image left (copy on right)"}], "default": "image_right", "info": "Image on left or right on desktop. Mobile always stacks single column."}, {"type": "text", "id": "eyebrow", "label": "Eyebrow (small caps)", "default": "Power"}, {"type": "text", "id": "title", "label": "Title", "default": "Conquer Every Hill with Peak 1000W Power"}, {"type": "richtext", "id": "body", "label": "Body", "info": "Rich text — HTML like <br> and <strong> supported.", "default": "The Maxfoot brushless hub motor delivers a staggering 1000W of peak power, providing you with smooth, robust acceleration and the torque needed to tackle steep inclines without breaking a sweat."}, {"type": "image_picker", "id": "image", "label": "Feature image", "info": "Recommended: 1200×900 (4:3). 1.5x for retina: 1800×1350. object-fit:cover fills the column, so a 4:3 source avoids cropping. <300KB."}, {"type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 80}, {"type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 80}], "presets": [{"name": "MF25 Stitch Feature"}]}
{% endschema %}