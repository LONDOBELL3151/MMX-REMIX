{%- liquid
  assign s = section.settings
-%}

<section class="about-founder" {{ section.shopify_attributes }}>
  <div class="about-founder__inner">
    {%- for block in section.blocks -%}
      {%- if block.type == 'slogan' -%}
        {%- assign bg = block.settings.bg_image -%}
        <div class="about-founder__slogan{% if bg != blank %} about-founder__slogan--has-bg{% endif %}" {{ block.shopify_attributes }}>
          {%- if bg != blank -%}
            <div class="about-founder__slogan-bg" aria-hidden="true">
              <img
                src="{{ bg | image_url: width: 1920 }}"
                srcset="{{ bg | image_url: width: 960 }} 960w, {{ bg | image_url: width: 1280 }} 1280w, {{ bg | image_url: width: 1920 }} 1920w"
                sizes="100vw"
                alt=""
                loading="lazy">
            </div>
            <div class="about-founder__slogan-overlay" aria-hidden="true"></div>
          {%- endif -%}

          <div class="container about-founder__slogan-inner">
            <h2 class="about-founder__slogan-h">{{ block.settings.slogan | newline_to_br }}</h2>
          </div>
        </div>

        {%- if block.settings.content_title != blank or block.settings.content_body != blank -%}
        <div class="about-founder__content" {{ block.shopify_attributes }}>
          <div class="container about-founder__content-inner">
            {%- if block.settings.content_title != blank -%}
              <h3 class="about-founder__content-title">{{ block.settings.content_title }}</h3>
            {%- endif -%}
            {%- if block.settings.content_body != blank -%}
              <div class="about-founder__content-body">{{ block.settings.content_body }}</div>
            {%- endif -%}
          </div>
        </div>
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{ "name": "About Founder (Slogans)", "tag": "section", "class": "section-about-founder", "settings": [], "blocks": [ { "type": "slogan", "name": "Slogan + Content", "settings": [ { "type": "textarea", "id": "slogan", "label": "Big slogan (1-2 lines)", "info": "Shown as a huge full-width H1. Use line breaks for multi-line slogans." }, { "type": "image_picker", "id": "bg_image", "label": "Background image (optional)", "info": "Recommended: 1920x1080 (16:9), JPG/PNG, <500KB. Adds a dark full-bleed background under the slogan." }, { "type": "text", "id": "content_title", "label": "Content heading (after slogan)", "info": "Shown in a white section right after the slogan." }, { "type": "richtext", "id": "content_body", "label": "Content body (after slogan)" } ] } ], "max_blocks": 6, "presets": [ { "name": "About Founder (Slogans)", "blocks": [ { "type": "slogan", "settings": { "slogan": "Honest pricing.<br>Real rides.", "content_title": "From Our Team", "content_body": "<p>At MaxFoot, every decision starts with the rider — not the showroom. We design electric trikes for grocery runs, family outings, and daily commutes, and we ship them direct from our factory so you skip the premium markup.</p>" } }, { "type": "slogan", "settings": { "slogan": "Built for real<br>riders.", "content_title": "Designed Around You", "content_body": "<p>Stability, comfort, and storage for seniors. Two-seater options for families. Practical range and weather-ready components for commuters. We engineer every model around the people who actually use it — not around a marketing pitch.</p>" } }, { "type": "slogan", "settings": { "slogan": "Engineered for<br>everyday.", "content_title": "Quality You Can Trust", "content_body": "<p>UL-certified Samsung batteries, 750W motors tested on real hills, hydraulic brakes, and 2-year warranty on every model. If it doesn't ride well in a grocery store parking lot, it doesn't ship.</p>" } }, { "type": "slogan", "settings": { "slogan": "Community on<br>three wheels.", "content_title": "From the MaxFoot Family", "content_body": "<p>We didn't just want to engineer the best electric tricycle for adults — we wanted to bring back the pure joy of riding. Whether you're upgrading your daily commute or looking for the perfect electric tricycle for 2 adults to share with a loved one, we build every vehicle with your safety and freedom in mind.</p>" } } ] } ] }
{% endschema %}