{% render 'swoope-styles' %}

{%- liquid
  assign s = section.settings
  assign card_count = 0
  for block in section.blocks
    if block.type == 'card'
      assign card_count = card_count | plus: 1
    endif
  endfor
  if card_count == 0
    assign card_count = 1
  endif
-%}

<style>
.sw-mech{position:relative;background:var(--sw-surface-0);border-top:1px solid var(--sw-surface-highest);min-height:calc(var(--sw-mech-count,1) * 100vh)}
.sw-mech-stage{position:sticky;top:0;height:100vh;overflow:hidden;z-index:1}
.sw-mech-bg{position:absolute;inset:0;z-index:0}
.sw-mech-bg-slide{position:absolute;inset:0;background:var(--sw-surface-low);opacity:0;transition:opacity .25s linear;overflow:hidden}
.sw-mech-bg-slide img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block}
.sw-mech-bg-slide::after{content:"";position:absolute;inset:0;background:rgba(10,10,10,0.55)}
.sw-mech-bg-slide.is-active{opacity:1}
.sw-mech-heading{position:absolute;top:140px;left:0;right:0;text-align:center;z-index:3;font-family:var(--sw-display);font-weight:700;font-size:clamp(32px,4vw,48px);line-height:1.1;letter-spacing:-0.02em;color:var(--sw-on-surface);margin:0;padding:0 var(--sw-gutter);text-shadow:0 2px 12px rgba(0,0,0,0.6)}
.sw-mech-cards{position:absolute;left:0;right:0;bottom:0;z-index:2;display:flex;align-items:flex-end;justify-content:flex-start;padding:64px var(--sw-gutter);pointer-events:none}
.sw-mech-card{position:absolute;left:var(--sw-gutter);bottom:64px;display:flex;flex-direction:row;align-items:center;gap:24px;background:rgba(20,20,20,0.55);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);border:1px solid rgba(255,255,255,0.08);border-radius:var(--sw-r-xl);padding:24px 32px;max-width:760px;opacity:0;transition:opacity .25s linear}
.sw-mech-card.is-active{opacity:1}
.sw-mech-card .sw-mech-icon{flex:0 0 56px;width:56px;height:56px;color:var(--sw-lime);display:flex;align-items:center;justify-content:center}
.sw-mech-card .sw-mech-icon svg{width:100%;height:100%;display:block}
.sw-mech-card .sw-mech-content{display:flex;flex-direction:column;gap:6px;min-width:0}
.sw-mech-card .sw-mech-label{font-family:var(--sw-mono);font-size:13px;font-weight:500;letter-spacing:0.05em;text-transform:uppercase;color:var(--sw-on-surface-variant);margin:0}
.sw-mech-card .sw-mech-value{font-family:var(--sw-display);font-size:28px;font-weight:600;line-height:1.1;color:var(--sw-lime);margin:0}
.sw-mech-card .sw-mech-body{font-family:var(--sw-body);font-size:14px;line-height:1.5;color:var(--sw-on-surface-variant);margin:6px 0 0;max-width:60ch}
@media (max-width:960px){
  .sw-mech-cards{padding:32px 20px}
  .sw-mech-card{left:20px;right:20px;bottom:32px;padding:20px;gap:16px;flex-direction:column;align-items:flex-start}
  .sw-mech-card .sw-mech-icon{flex:0 0 40px;width:40px;height:40px}
}
</style>

<section class="sw-mech" data-mech-section style="--sw-mech-count:{{ card_count }}" {{ section.shopify_attributes }}>
  <div class="sw-mech-stage" data-mech-stage>
    {%- if card_count > 0 -%}
      <div class="sw-mech-bg" data-mech-bg>
        {%- for block in section.blocks -%}
          {%- if block.type == 'card' -%}
            <div class="sw-mech-bg-slide{% if forloop.first %} is-active{% endif %}" data-mech-bg-slide>
              {%- if block.settings.image != blank -%}
                <img src="{{ block.settings.image | image_url: width: 1920 }}" alt="" loading="eager" width="1920" height="1080">
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>

      <h2 class="sw-mech-heading">{{ s.title | escape }}</h2>

      <div class="sw-mech-cards" data-mech-cards aria-live="polite">
        {%- for block in section.blocks -%}
          {%- if block.type == 'card' -%}
            <div class="sw-mech-card{% if forloop.first %} is-active{% endif %}" data-mech-card aria-hidden="{% unless forloop.first %}true{% else %}false{% endunless %}">
              <div class="sw-mech-icon" aria-hidden="true">
                {%- case block.settings.icon -%}
                  {%- when 'motor' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/><circle cx="12" cy="12" r="3"/></svg>
                  {%- when 'battery' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="18" height="10" rx="2"/><path d="M22 11v2"/><path d="M6 11v2M10 11v2M14 11v2"/></svg>
                  {%- when 'frame' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 4l4 8-3 8M19 4l-4 8 3 8M5 4h14M5 20h14M9 12h6"/></svg>
                  {%- when 'suspension' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v6M8 8h8M10 8v12M14 8v12M8 20h8"/><circle cx="12" cy="3" r="1.5"/></svg>
                  {%- when 'brakes' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="3"/></svg>
                  {%- when 'layers' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
                  {%- when 'water' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"/></svg>
                  {%- else -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/></svg>
                {%- endcase -%}
              </div>
              <div class="sw-mech-content">
                <p class="sw-mech-label">{{ block.settings.label | escape }}</p>
                <p class="sw-mech-value">{{ block.settings.value | escape }}</p>
                <p class="sw-mech-body">{{ block.settings.body }}</p>
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

<script>
(function(){
  var section = document.querySelector('[data-mech-section]');
  if(!section) return;
  var stage = section.querySelector('[data-mech-stage]');
  var bgSlides = section.querySelectorAll('[data-mech-bg-slide]');
  var cards = section.querySelectorAll('[data-mech-card]');
  if(!stage || bgSlides.length === 0) return;

  var N = bgSlides.length;

  function update(){
    // Use the SECTION's rect (not the sticky stage's — a sticky element
    // pinned at top:0 has rect.top = 0 throughout pinning, which would
    // freeze our progress. The section itself scrolls past viewport top
    // normally while the stage is pinned inside it, so its top going
    // negative is what we use to track scroll progress through the section).
    var rect = section.getBoundingClientRect();
    var scrolled = -rect.top;
    // Scroll range while stage is pinned = section height - 1 viewport
    var range = section.offsetHeight - window.innerHeight;
    if (range <= 0) {
      range = 1; // safety against zero
    }
    var progress = Math.min(1, Math.max(0, scrolled / range));
    // Floating index 0..N-1
    var idx = progress * (N - 1);

    for(var i = 0; i < bgSlides.length; i++){
      var distance = Math.abs(i - idx);
      // Steeper fade — only the active card and its immediate neighbor
      // hold visible opacity; anything further away is fully hidden so
      // stacked cards don't visually overlap their text.
      var opacity = Math.max(0, 1 - distance * 1.4);
      bgSlides[i].style.opacity = opacity;
      bgSlides[i].classList.toggle('is-active', opacity > 0.5);
    }
    for(var j = 0; j < cards.length; j++){
      var d = Math.abs(j - idx);
      var o = Math.max(0, 1 - d * 1.4);
      cards[j].style.opacity = o;
      cards[j].classList.toggle('is-active', o > 0.5);
      cards[j].setAttribute('aria-hidden', o > 0.5 ? 'false' : 'true');
    }
  }

  var ticking = false;
  function onScroll(){
    if(ticking) return;
    ticking = true;
    requestAnimationFrame(function(){
      update();
      ticking = false;
    });
  }

  window.addEventListener('scroll', onScroll, {passive:true});
  window.addEventListener('resize', onScroll);
  update();
})();
</script>

{% schema %}
{
  "name": "SWOOPE Mechanical",
  "tag": "section",
  "class": "section-swoope-mechanical",
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "Mechanical Breakdown" },
    { "type": "header", "content": "Section spacing" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 96 }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Spec card",
      "limit": 8,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Background image for this spec",
          "info": "Renders as the section's fullscreen background image when this spec is active (one viewport tall — covers the whole sticky stage). Recommended: 1920×1080 (16:9) for 1× desktop coverage, 3840×2160 for 2× retina. object-fit:cover crops loose aspect so a wider source also works." },
        { "type": "select", "id": "icon", "label": "Icon",
          "options": [
            { "value": "motor",      "label": "Motor" },
            { "value": "battery",    "label": "Battery" },
            { "value": "frame",      "label": "Frame" },
            { "value": "suspension", "label": "Suspension" },
            { "value": "brakes",     "label": "Brakes" },
            { "value": "layers",     "label": "Layers / carbon" },
            { "value": "water",      "label": "Water / IP rating" },
            { "value": "none",       "label": "None" }
          ],
          "default": "motor" },
        { "type": "text", "id": "label", "label": "Label", "default": "Motor" },
        { "type": "text", "id": "value", "label": "Value", "default": "60kW Liquid Cooled" },
        { "type": "textarea", "id": "body", "label": "Body",
          "default": "Direct drive permanent magnet motor delivering instantaneous torque. The advanced liquid cooling system guarantees sustained peak performance, completely eliminating thermal throttling even during the most demanding climbs or prolonged high-speed runs." }
      ]
    }
  ],
  "presets": [
    {
      "name": "SWOOPE Mechanical",
      "blocks": [
        { "type": "card", "settings": {
          "icon": "motor", "label": "Motor", "value": "60kW Liquid Cooled",
          "body": "Direct drive permanent magnet motor delivering instantaneous torque. The advanced liquid cooling system guarantees sustained peak performance, completely eliminating thermal throttling even during the most demanding climbs or prolonged high-speed runs."
        } },
        { "type": "card", "settings": {
          "icon": "battery", "label": "Battery", "value": "6.5kWh Lithium Ion",
          "body": "High-density performance pack housed in a structural carbon fiber casing utilizing premium Samsung 21700 cells. Capable of a rapid 45-minute fast charge to 80%, ensuring you spend more time riding and less time waiting."
        } },
        { "type": "card", "settings": {
          "icon": "suspension", "label": "Suspension", "value": "310mm Travel",
          "body": "Fully adjustable inverted front forks and rear monoshock, meticulously tuned for extreme off-road compression. Features a sophisticated 24-way adjustable high-speed compression damping system to perfectly dial in the ride feel for any rider weight or terrain type."
        } },
        { "type": "card", "settings": {
          "icon": "brakes", "label": "Brakes", "value": "Brembo Performance",
          "body": "4-piston radial-mount calipers on oversized floating rotors provide fade-free, maximum stopping power. This is seamlessly integrated with an aggressive regenerative braking system that recaptures kinetic energy, extending your range while saving pad wear."
        } }
      ]
    }
  ]
}
{% endschema %}