<section class="mf25-hero" id="mf25-stitch-hero" {{ section.shopify_attributes }}>
  <div class="container">
    <div class="mf25-hero-grid">
      <div class="mf25-gallery">
        {%- if product.featured_media -%}
          <img src="{{ product.featured_media | image_url: width: 1200 }}" alt="{{ product.title | escape }}" loading="eager">
        {%- else -%}
          <img src="https://images.unsplash.com/photo-1532298229144-0ec0c57515c7?w=1200&h=900&fit=crop" alt="Maxfoot MF-25 Burning Orange" loading="eager">
        {%- endif -%}
      </div>

      <div class="mf25-buybox">
        <span class="mf25-stock-pill">{{ s.stock_label }}</span>
        <h1 class="mf25-title">{{ s.title }}</h1>

        <div class="mf25-price-row">
          <span class="mf25-price">${{ s.price_now }}</span>
          <span class="mf25-price-was">${{ s.price_was }}</span>
          <span class="mf25-save-pill">{{ s.save_label }}</span>
        </div>
        <p class="mf25-price-foot">or 4 interest-free payments of ${{ s.price_now | divided_by: 4.0 | round }}</p>

        <div class="mf25-color-row">
          <h3>{{ s.color_label }}: {{ s.color_default }}</h3>
          <div class="mf25-swatches">
            <button class="mf25-swatch mf25-swatch-fire is-active" type="button" aria-label="Burning Orange"></button>
            <button class="mf25-swatch mf25-swatch-graphite" type="button" aria-label="Graphite"></button>
            <button class="mf25-swatch mf25-swatch-green" type="button" aria-label="Verdant Green"></button>
            <button class="mf25-swatch mf25-swatch-blue" type="button" aria-label="Zandvoort Blue"></button>
            <button class="mf25-swatch mf25-swatch-navy" type="button" aria-label="Midnight Navy"></button>
          </div>
        </div>

        <div class="mf25-spec-strip">
          <div>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
            {{ s.spec_motor }}
          </div>
          <div>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="6" y="6" width="12" height="16" rx="2"/><line x1="12" y1="2" x2="12" y2="6"/><line x1="9" y1="14" x2="15" y2="14"/></svg>
            {{ s.spec_battery }}
          </div>
          <div>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="5.5" cy="17.5" r="3.5"/><circle cx="18.5" cy="17.5" r="3.5"/><path d="M15 6a1 1 0 100-2 1 1 0 000 2zm-3 11.5V14l-3-3 4-3 2 3h2"/></svg>
            {{ s.spec_gears }}
          </div>
          <div>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18h6M10 22h4M12 2a7 7 0 0 0-4 12.7c.8.7 1.5 1.7 1.5 2.8V18h5v-.5c0-1.1.7-2.1 1.5-2.8A7 7 0 0 0 12 2z"/></svg>
            {{ s.spec_light }}
          </div>
        </div>

        <button class="mf25-btn-primary" type="button">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.7 13.4a2 2 0 0 0 2 1.6h9.7a2 2 0 0 0 2-1.6L23 6H6"/></svg>
          {{ s.cta_label }}
        </button>

        <div class="mf25-trust-bar">
          <div class="mf25-trust-item">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
            <strong>FREE Shipping</strong>
            {{ s.trust_1 | split: 'FREE Shipping' | last }}
          </div>
          <div class="mf25-trust-item">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 12l2 2 4-4"/><path d="M21 12c0 4.97-4.03 9-9 9s-9-4.03-9-9 4.03-9 9-9c2.49 0 4.74 1.01 6.36 2.64"/></svg>
            <strong>2-Year</strong>
            {{ s.trust_2 | remove: '2-Year Warranty' | strip }}
          </div>
          <div class="mf25-trust-item">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 21h18M5 21V7l8-4v18M19 21V11l-6-4"/></svg>
            <strong>US Warehouse</strong>
            {{ s.trust_3 | remove: 'US Warehouse' | strip }}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "MF25 Stitch Hero",
  "tag": "section",
  "class": "section-mf25-stitch-hero",
  "settings": [
    { "type": "text", "id": "stock_label", "label": "Stock pill text", "default": "In Stock" },
    { "type": "text", "id": "title", "label": "Product title", "default": "Maxfoot MF-25 Electric Commuter Bike | Step-Thru" },
    { "type": "text", "id": "price_now", "label": "Price (now)", "default": "659" },
    { "type": "text", "id": "price_was", "label": "Price (was)", "default": "1299" },
    { "type": "text", "id": "save_label", "label": "Save pill", "default": "Save $640" },
    { "type": "text", "id": "color_label", "label": "Color row label", "default": "Color" },
    { "type": "text", "id": "color_default", "label": "Default color name", "default": "Burning Orange" },
    { "type": "text", "id": "spec_motor", "label": "Spec chip: motor", "default": "Peak 1000W Motor" },
    { "type": "text", "id": "spec_battery", "label": "Spec chip: battery", "default": "500Wh Battery" },
    { "type": "text", "id": "spec_gears", "label": "Spec chip: gears", "default": "Shimano 7-Speed" },
    { "type": "text", "id": "spec_light", "label": "Spec chip: light", "default": "LED Front/Tail" },
    { "type": "text", "id": "cta_label", "label": "CTA button text", "default": "Add to Cart" },
    { "type": "text", "id": "trust_1", "label": "Trust item 1", "default": "FREE Shipping to 48 states" },
    { "type": "text", "id": "trust_2", "label": "Trust item 2", "default": "2-Year Warranty" },
    { "type": "text", "id": "trust_3", "label": "Trust item 3", "default": "US Warehouse CA Ships Fast" }
  ]
}
{% endschema %}