{%- liquid
  assign s = section.settings
-%}
{% render 'mf35-stitch-styles' %}

<div class="mf35-root">
  <section class="mf35-size" style="padding-top:{{ s.padding_top }}px;padding-bottom:{{ s.padding_bottom }}px" {{ section.shopify_attributes }}>
    <div class="mf35-container">
      <div class="mf35-size-head">
        <span class="mf35-kicker">{{ s.kicker | escape }}</span>
        <h2>{{ s.heading | escape }}</h2>
        <p>{{ s.subheading | escape }}</p>
      </div>

      <div class="mf35-perf-grid">
        {%- for block in section.blocks -%}
          {%- if block.type == 'metric' -%}
            <div class="mf35-spec-card" {{ block.shopify_attributes }}>
              <div class="mf35-spec-head">
                <div class="mf35-spec-icon">
                  {%- if block.settings.custom_icon != blank -%}
                    <img src="{{ block.settings.custom_icon | image_url: width: 96 }}" alt="{{ block.settings.title | escape }}" loading="lazy" width="22" height="22">
                  {%- else -%}
                    {%- case block.settings.icon -%}
                      {%- when 'motor' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" stroke-linecap="round" stroke-linejoin="round"/></svg>
                      {%- when 'battery' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="18" height="10" rx="2"/><path d="M22 11v2" stroke-linecap="round"/><path d="M6 10v4M9 10v4M12 10v4" stroke-linecap="round"/></svg>
                      {%- when 'weight' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6.5 6.5h11M9 6.5V4h6v2.5M4 6.5h16l1.5 13H2.5L4 6.5z" stroke-linejoin="round"/></svg>
                      {%- when 'folder' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-7l-2-3H5a2 2 0 00-2 2v1z" stroke-linejoin="round"/></svg>
                      {%- when 'speed' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 12l4-4M12 12V7" stroke-linecap="round"/></svg>
                      {%- else -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M9 12l2 2 4-4" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    {%- endcase -%}
                  {%- endif -%}
                </div>
                {%- if block.settings.tag != blank -%}
                  <span class="mf35-spec-tag">{{ block.settings.tag | escape }}</span>
                {%- endif -%}
              </div>

              <div class="mf35-spec-body">
                <div>
                  <span class="mf35-spec-value">{{ block.settings.metric_value | escape }}</span>
                  {%- if block.settings.metric_unit != blank -%}
                    <span class="mf35-spec-unit">{{ block.settings.metric_unit | escape }}</span>
                  {%- endif -%}
                </div>
                <div class="mf35-spec-title">{{ block.settings.title | escape }}</div>
                {%- if block.settings.body != blank -%}
                  <p class="mf35-spec-desc">{{ block.settings.body | escape }}</p>
                {%- endif -%}
              </div>

              {%- if block.settings.foot_left != blank or block.settings.foot_right != blank -%}
                <div class="mf35-spec-foot">
                  {%- if block.settings.foot_left != blank -%}
                    <span>{{ block.settings.foot_left | escape }}</span>
                  {%- endif -%}
                  {%- if block.settings.foot_right != blank -%}
                    <span>{{ block.settings.foot_right | escape }}</span>
                  {%- endif -%}
                </div>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "MF35 Stitch Performance",
  "tag": "section",
  "class": "section-mf35-stitch-performance",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "// POWERTRAIN & CHASSIS DYNAMICS", "info": "≤50 chars" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "ENGINEERED FOR ABSOLUTE STABILITY" },
    { "type": "textarea", "id": "subheading", "label": "Subheading",
      "default": "The MF-35 integrates proprietary differential rear-wheel drive and balanced weight distribution for zero-lean riding confidence on pavement, gravel, and grass." },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 60 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 60 }
  ],
  "blocks": [
    {
      "type": "metric",
      "name": "Metric card",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon (preset)",
          "options": [
            { "value": "motor", "label": "Motor (lightning)" },
            { "value": "battery", "label": "Battery (cells)" },
            { "value": "weight", "label": "Weight (chassis)" },
            { "value": "folder", "label": "Fold (latch)" },
            { "value": "speed", "label": "Speed (gauge)" },
            { "value": "check", "label": "Generic (check)" }
          ],
          "default": "motor",
          "info": "Used when no Custom icon is uploaded below." },
        { "type": "image_picker", "id": "custom_icon", "label": "Custom icon (overrides preset)",
          "info": "Recommended: 48×48 SVG or PNG with transparent background, single color. Rendered at 22px inside the 42×42 yellow container. <30KB." },
        { "type": "text", "id": "tag", "label": "Top-right tag (mono)", "info": "e.g. TORQUE: 65 NM" },
        { "type": "text", "id": "metric_value", "label": "Metric value (big number)", "default": "750" },
        { "type": "text", "id": "metric_unit", "label": "Metric unit (yellow accent)", "default": "W" },
        { "type": "text", "id": "title", "label": "Title", "default": "Peak Hub Motor" },
        { "type": "textarea", "id": "body", "label": "Description",
          "default": "High-efficiency geared brushless motor climbs 20-degree hills with smooth, responsive low-end torque delivery." },
        { "type": "text", "id": "foot_left", "label": "Foot left (mono)", "info": "e.g. 5-LEVEL PEDAL ASSIST" },
        { "type": "text", "id": "foot_right", "label": "Foot right (mono)", "info": "e.g. + THUMB THROTTLE" }
      ]
    }
  ],
  "presets": [
    {
      "name": "MF35 Stitch Performance",
      "blocks": [
        { "type": "metric", "settings": { "icon": "motor", "tag": "TORQUE: 65 NM", "metric_value": "750", "metric_unit": "W", "title": "Peak Hub Motor", "body": "High-efficiency geared brushless motor climbs 20-degree hills with smooth, responsive low-end torque delivery.", "foot_left": "5-LEVEL PEDAL ASSIST", "foot_right": "+ THUMB THROTTLE" } },
        { "type": "metric", "settings": { "icon": "battery", "tag": "48V ARCHITECTURE", "metric_value": "55-75", "metric_unit": "MI", "title": "Tested Range", "body": "UL 2849 certified grade-A lithium cells with Smart BMS safeguard against overcharge, short circuit, and cell thermal drift.", "foot_left": "CHARGE TIME: 4-6 HRS", "foot_right": "REMOVABLE PACK" } },
        { "type": "metric", "settings": { "icon": "weight", "tag": "REINFORCED CHASSIS", "metric_value": "400", "metric_unit": "LBS", "title": "Gross Payload", "body": "Accommodates adult riders up to 250 lbs alongside a dedicated 150 lb rear cargo crate for groceries, pets, and supplies.", "foot_left": "CARGO BASKET: 52L VOL", "foot_right": "STEEL GUSSETED" } },
        { "type": "metric", "settings": { "icon": "folder", "tag": "LATCH MECHANISM", "metric_value": "10", "metric_unit": "SEC", "title": "Quick-Fold Action", "body": "Two quick-release clamps fold the central frame and handlebar post to fit conveniently into SUV trunks, elevators, or closets.", "foot_left": "FOLDED: 41\" × 31\"", "foot_right": "ZERO TOOLS NEEDED" } }
      ]
    }
  ]
}
{% endschema %}