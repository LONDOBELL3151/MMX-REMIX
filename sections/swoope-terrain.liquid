{% render 'swoope-styles' %}

{%- liquid
  assign s = section.settings
  assign card_count = 0
  for block in section.blocks
    if block.type == 'card'
      assign card_count = card_count | plus: 1
    endif
  endfor
-%}

<style>
.sw-terrain{position:relative;padding:var(--sw-section) 0;background:rgba(28,27,27,0.3);border-top:1px solid var(--sw-surface-highest);overflow:hidden}
.sw-terrain-carousel{position:absolute;inset:0;z-index:0;pointer-events:none}
.sw-terrain-slide{position:absolute;inset:0;background-size:cover;background-position:center;background-repeat:no-repeat;background-color:var(--sw-surface-low);opacity:0;transition:opacity var(--sw-terrain-fade,1000ms) ease-in-out}
.sw-terrain-slide.is-active{opacity:1}
.sw-terrain-slide::after{content:"";position:absolute;inset:0;background:rgba(14,14,14,0.55)}
.sw-terrain-head{text-align:center;margin-bottom:48px;max-width:768px;margin-left:auto;margin-right:auto;position:relative;z-index:2}
.sw-terrain-head h2{font-family:var(--sw-display);font-weight:700;font-size:clamp(32px,4vw,48px);line-height:1.1;letter-spacing:-0.02em;color:var(--sw-on-surface);margin:0}
.sw-terrain-head p{font-family:var(--sw-body);font-size:18px;line-height:1.6;color:var(--sw-on-surface-variant);margin:16px auto 0;max-width:640px}
.sw-terrain-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;position:relative;z-index:2}
.sw-terrain-card{position:relative;background:var(--sw-surface-0);border:1px solid var(--sw-surface-highest);border-radius:var(--sw-r-lg);padding:32px;min-height:280px;overflow:hidden}
.sw-terrain-card .sw-terrain-fill{position:absolute;left:0;top:0;bottom:0;width:0;background:var(--sw-lime);z-index:1;pointer-events:none;transition:none}
.sw-terrain-card.is-active .sw-terrain-fill{width:100%;transition:width var(--sw-terrain-interval,3000ms) linear}
.sw-terrain-card .sw-terrain-overlay{position:relative;z-index:2;display:flex;flex-direction:column;gap:16px}
.sw-terrain-card h3{font-family:var(--sw-display);font-size:24px;font-weight:600;line-height:1.3;color:var(--sw-lime);margin:0;transition:color .35s ease .15s}
.sw-terrain-card p{font-family:var(--sw-body);font-size:15px;line-height:1.6;color:var(--sw-on-surface);margin:0;transition:color .35s ease .15s}
.sw-terrain-card.is-active h3{color:var(--sw-on-lime)}
.sw-terrain-card.is-active p{color:var(--sw-on-lime)}
.sw-terrain-indicators{display:flex;justify-content:center;gap:8px;margin-top:32px;position:relative;z-index:2}
.sw-terrain-indicator{flex:1;max-width:120px;height:3px;background:rgba(255,255,255,0.15);border-radius:2px;overflow:hidden;position:relative}
.sw-terrain-indicator::after{content:"";position:absolute;left:0;top:0;bottom:0;width:0;background:var(--sw-lime);box-shadow:0 0 8px rgba(195,244,0,0.4)}
.sw-terrain-indicator.is-active::after{width:100%;transition:width var(--sw-terrain-interval,3000ms) linear}
@media (max-width:960px){
  .sw-terrain-grid{grid-template-columns:1fr;gap:16px}
  .sw-terrain-card .sw-terrain-fill{transition:width .4s ease !important}
  .sw-terrain-card.is-active .sw-terrain-fill{transition:width var(--sw-terrain-interval,3000ms) linear}
  .sw-tertain-indicators{flex-direction:column;align-items:stretch}
}
@media (max-width:720px){.sw-terrain{padding:64px 0}.sw-terrain-head{margin-bottom:32px}}
</style>

<section class="sw-terrain" style="padding-top:{{ s.padding_top | default: 96 }}px;padding-bottom:{{ s.padding_bottom | default: 96 }}px;--sw-terrain-interval:{{ s.interval | default: 3000 }}ms;--sw-terrain-fade:1000ms" {{ section.shopify_attributes }}>
  {%- if card_count > 0 -%}
    <div class="sw-terrain-carousel" data-terrain-carousel aria-hidden="true">
      {%- for block in section.blocks -%}
        {%- if block.type == 'card' -%}
          <div class="sw-terrain-slide{% if forloop.first %} is-active{% endif %}" data-terrain-slide style="{% if block.settings.image != blank %}background-image:url('{{ block.settings.image | image_url: width: 1600 }}'){% endif %}"></div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- endif -%}

  <div class="sw-container">
    <div class="sw-terrain-head">
      <h2>{{ s.title | escape }}</h2>
      {%- if s.body != blank -%}
        <p>{{ s.body }}</p>
      {%- endif -%}
    </div>

    {%- if card_count > 0 -%}
      <div class="sw-terrain-grid" data-terrain-grid>
        {%- for block in section.blocks -%}
          {%- if block.type == 'card' -%}
            <div class="sw-terrain-card" data-terrain-card {{ block.shopify_attributes }}>
              <div class="sw-terrain-fill" data-terrain-fill aria-hidden="true"></div>
              <div class="sw-terrain-overlay">
                <h3>{{ block.settings.heading | escape }}</h3>
                <p>{{ block.settings.body }}</p>
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>

      <div class="sw-terrain-indicators" data-terrain-indicators aria-hidden="true">
        {%- for block in section.blocks -%}
          {%- if block.type == 'card' -%}
            <span class="sw-terrain-indicator{% if forloop.first %} is-active{% endif %}" data-terrain-indicator></span>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

<script>
(function(){
  var root = document.querySelector('[data-terrain-grid]');
  if(!root) return;
  var section = root.closest('.section-swoope-terrain');
  var cards = root.querySelectorAll('[data-terrain-card]');
  var slides = section ? section.querySelectorAll('[data-terrain-slide]') : [];
  var indicators = section ? section.querySelectorAll('[data-terrain-indicator]') : [];
  if(cards.length === 0) return;

  var interval = 3000;
  if(section){
    var raw = getComputedStyle(section).getPropertyValue('--sw-terrain-interval') || '';
    var n = parseInt(raw, 10);
    if(!isNaN(n) && n > 0) interval = n;
  }

  var activeIdx = 0;
  var timer = null;
  var paused = false;

  function setActive(i){
    cards.forEach(function(c, j){ c.classList.toggle('is-active', j === i); });
    slides.forEach(function(s, j){ s.classList.toggle('is-active', j === i); });
    indicators.forEach(function(el, j){ el.classList.toggle('is-active', j === i); });
  }

  function start(){
    if(timer || paused) return;
    timer = setInterval(function(){
      activeIdx = (activeIdx + 1) % cards.length;
      setActive(activeIdx);
    }, interval);
  }

  function stop(){
    if(timer){ clearInterval(timer); timer = null; }
  }

  setActive(0);
  start();

  if(section){
    section.addEventListener('mouseenter', function(){
      paused = true;
      stop();
      cards.forEach(function(c){ c.classList.remove('is-active'); });
      indicators.forEach(function(el){ el.classList.remove('is-active'); });
    });
    section.addEventListener('mouseleave', function(){
      paused = false;
      setActive(activeIdx);
      start();
    });
  }
})();
</script>

{% schema %}
{
  "name": "SWOOPE Terrain",
  "tag": "section",
  "class": "section-swoope-terrain",
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "Master Any Terrain" },
    { "type": "textarea", "id": "body", "label": "Body",
      "default": "Switch seamlessly between three distinct ride profiles engineered for varying demands, putting total control over the powertrain directly at your fingertips." },
    { "type": "range", "id": "interval", "label": "Auto-rotate interval (ms)", "min": 1500, "max": 8000, "step": 500, "unit": "ms", "default": 3000,
      "info": "How long each card stays active before rotating. The fill animation runs over this same duration." },
    { "type": "header", "content": "Section spacing" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 96 }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Ride profile",
      "limit": 6,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Section carousel image (one per profile)",
          "info": "Recommended: 1600×900 (16:9) for the section background. Each card's image becomes a slide in the section's rotating carousel — slide N is active when card N is active." },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Enduro" },
        { "type": "textarea", "id": "body", "label": "Body",
          "default": "Optimized for maximum efficiency and range. Smooth torque delivery preserves battery life for long, technical backcountry explorations without sacrificing necessary low-end grunt." }
      ]
    }
  ],
  "presets": [
    {
      "name": "SWOOPE Terrain",
      "blocks": [
        { "type": "card", "settings": {
          "heading": "Enduro",
          "body": "Optimized for maximum efficiency and range. Smooth torque delivery preserves battery life for long, technical backcountry explorations without sacrificing necessary low-end grunt."
        } },
        { "type": "card", "settings": {
          "heading": "Trail",
          "body": "The perfect balance of power and agility. Dialed for responsive acceleration and precise handling on tight, winding tracks and varied off-road conditions."
        } },
        { "type": "card", "settings": {
          "heading": "Racer",
          "body": "Unleash the full 80 HP and 250Nm of torque. Minimal intervention, maximum aggressive mapping for competitive track days and wide-open throttle blasts."
        } }
      ]
    }
  ]
}
{% endschema %}