{% render 'swoope-styles' %}

{%- liquid
  assign s = section.settings
  assign card_count = 0
  for block in section.blocks
    if block.type == 'card'
      assign card_count = card_count | plus: 1
    endif
  endfor
-%}

<style>
.sw-terrain{padding:var(--sw-section) 0;background:rgba(28,27,27,0.3);border-top:1px solid var(--sw-surface-highest)}
.sw-terrain-head{text-align:center;margin-bottom:48px;max-width:768px;margin-left:auto;margin-right:auto}
.sw-terrain-head h2{font-family:var(--sw-display);font-weight:700;font-size:clamp(32px,4vw,48px);line-height:1.1;letter-spacing:-0.02em;color:var(--sw-on-surface);margin:0}
.sw-terrain-head p{font-family:var(--sw-body);font-size:18px;line-height:1.6;color:var(--sw-on-surface-variant);margin:16px auto 0;max-width:640px}
.sw-terrain-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:32px}
.sw-terrain-card{position:relative;overflow:hidden;border:1px solid var(--sw-surface-highest);border-radius:var(--sw-r-lg);background:var(--sw-surface-0);min-height:280px;transition:border-color .2s}
.sw-terrain-card:hover{border-color:rgba(195,244,0,0.5)}
.sw-terrain-card .sw-terrain-bg{position:absolute;inset:0;background:var(--sw-surface-low);opacity:0.45;filter:grayscale(0.6);transition:opacity .35s,filter .35s}
.sw-terrain-card.is-active .sw-terrain-bg{opacity:1;filter:none}
.sw-terrain-card .sw-terrain-bg img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block}
.sw-terrain-card .sw-terrain-overlay{position:relative;z-index:2;padding:32px;display:flex;flex-direction:column;gap:16px;background:linear-gradient(180deg,rgba(14,14,14,0) 0%,rgba(14,14,14,0.15) 55%,rgba(14,14,14,0.75) 100%);min-height:100%}
.sw-terrain-card h3{font-family:var(--sw-display);font-size:24px;font-weight:600;line-height:1.3;color:var(--sw-lime);margin:0;text-shadow:0 2px 8px rgba(0,0,0,0.4)}
.sw-terrain-card p{font-family:var(--sw-body);font-size:15px;line-height:1.6;color:var(--sw-on-surface);margin:0;text-shadow:0 1px 4px rgba(0,0,0,0.5)}
.sw-terrain-progress{position:absolute;left:0;bottom:0;height:4px;width:0;background:var(--sw-lime);z-index:3;box-shadow:0 0 12px rgba(195,244,0,0.4)}
.sw-terrain-card.is-active .sw-terrain-progress{width:100%;transition:width var(--sw-terrain-interval,3000ms) linear}
@media (max-width:960px){
  .sw-terrain-grid{grid-template-columns:1fr;gap:16px}
  .sw-terrain-progress{display:none}
  .sw-terrain-card.is-active .sw-terrain-bg{opacity:0.55;filter:none}
}
@media (max-width:720px){.sw-terrain{padding:64px 0}.sw-terrain-head{margin-bottom:32px}}
</style>

<section class="sw-terrain" style="padding-top:{{ s.padding_top | default: 96 }}px;padding-bottom:{{ s.padding_bottom | default: 96 }}px;--sw-terrain-interval:{{ s.interval | default: 3000 }}ms" {{ section.shopify_attributes }}>
  <div class="sw-container">
    <div class="sw-terrain-head">
      <h2>{{ s.title | escape }}</h2>
      {%- if s.body != blank -%}
        <p>{{ s.body }}</p>
      {%- endif -%}
    </div>

    {%- if card_count > 0 -%}
      <div class="sw-terrain-grid" data-terrain-grid>
        {%- for block in section.blocks -%}
          {%- if block.type == 'card' -%}
            <div class="sw-terrain-card" {{ block.shopify_attributes }}>
              <div class="sw-terrain-bg" data-terrain-bg>
                {%- if block.settings.image != blank -%}
                  <img src="{{ block.settings.image | image_url: width: 1200 }}" alt="{{ block.settings.heading | escape }}" loading="lazy" width="1200" height="800">
                {%- endif -%}
              </div>
              <div class="sw-terrain-overlay">
                <h3>{{ block.settings.heading | escape }}</h3>
                <p>{{ block.settings.body }}</p>
              </div>
              <div class="sw-terrain-progress" data-terrain-progress aria-hidden="true"></div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

<script>
(function(){
  var grid = document.querySelector('[data-terrain-grid]');
  if(!grid) return;
  var cards = grid.querySelectorAll('.sw-terrain-card');
  if(cards.length < 2) return;

  var section = grid.closest('.section-swoope-terrain') || grid.closest('section');
  var interval = parseInt((section && getComputedStyle(section).getPropertyValue('--sw-terrain-interval')) || '3000', 10);

  var activeIdx = 0;
  var timer = null;
  var paused = false;

  function setActive(i){
    cards.forEach(function(c, j){
      c.classList.toggle('is-active', j === i);
    });
  }

  function start(){
    if(timer || paused) return;
    timer = setInterval(function(){
      activeIdx = (activeIdx + 1) % cards.length;
      setActive(activeIdx);
    }, interval);
  }

  function stop(){
    if(timer){ clearInterval(timer); timer = null; }
  }

  // Initial: first card active (progress 0 → 100 over interval)
  setActive(activeIdx);
  start();

  // Pause when user hovers anywhere in the section
  if(section){
    section.addEventListener('mouseenter', function(){
      paused = true;
      stop();
      // Freeze progress mid-fill by removing is-active so width snaps to 0
      cards.forEach(function(c){ c.classList.remove('is-active'); });
    });
    section.addEventListener('mouseleave', function(){
      paused = false;
      // Resume from current activeIdx
      setActive(activeIdx);
      start();
    });
  }
})();
</script>

{% schema %}
{
  "name": "SWOOPE Terrain",
  "tag": "section",
  "class": "section-swoope-terrain",
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "Master Any Terrain" },
    { "type": "textarea", "id": "body", "label": "Body",
      "default": "Switch seamlessly between three distinct ride profiles engineered for varying demands, putting total control over the powertrain directly at your fingertips." },
    { "type": "range", "id": "interval", "label": "Auto-rotate interval (ms)", "min": 1500, "max": 8000, "step": 500, "unit": "ms", "default": 3000,
      "info": "How long each card stays active before rotating. The progress fill animates over this duration." },
    { "type": "header", "content": "Section spacing" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 96 }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Ride profile",
      "limit": 6,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Background banner image",
          "info": "Renders as the card's background. Recommended: 1200×800 (3:2) for the card's display area. Image fades in (and de-saturates when inactive) when this card becomes active." },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Enduro" },
        { "type": "textarea", "id": "body", "label": "Body",
          "default": "Optimized for maximum efficiency and range. Smooth torque delivery preserves battery life for long, technical backcountry explorations without sacrificing necessary low-end grunt." }
      ]
    }
  ],
  "presets": [
    {
      "name": "SWOOPE Terrain",
      "blocks": [
        { "type": "card", "settings": {
          "heading": "Enduro",
          "body": "Optimized for maximum efficiency and range. Smooth torque delivery preserves battery life for long, technical backcountry explorations without sacrificing necessary low-end grunt."
        } },
        { "type": "card", "settings": {
          "heading": "Trail",
          "body": "The perfect balance of power and agility. Dialed for responsive acceleration and precise handling on tight, winding tracks and varied off-road conditions."
        } },
        { "type": "card", "settings": {
          "heading": "Racer",
          "body": "Unleash the full 80 HP and 250Nm of torque. Minimal intervention, maximum aggressive mapping for competitive track days and wide-open throttle blasts."
        } }
      ]
    }
  ]
}
{% endschema %}