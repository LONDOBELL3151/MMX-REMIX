
{% render 'mf25-stitch-styles' %}

{%- liquid
  assign s = section.settings
-%}

<section class="mf25-conf" {{ section.shopify_attributes }}>
  <div class="container">
    {%- if s.title != blank -%}
      <div class="mf25-conf-head">
        <h2>{{ s.title | escape }}</h2>
      </div>
    {%- endif -%}
    <div class="mf25-conf-grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'item' -%}
          <div class="mf25-conf-item" {{ block.shopify_attributes }}>
            {%- if block.settings.icon != blank and block.settings.icon != 'none' -%}
              <div class="mf25-conf-mark">
                {%- case block.settings.icon -%}
                  {%- when 'truck' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M1 3h15v13H1z"/><path d="M16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                  {%- when 'headset' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 18v-6a9 9 0 0 1 18 0v6"/><path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"/></svg>
                  {%- else -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 22s8-3.5 8-10V5l-8-3-8 3v7c0 6.5 8 10 8 10z"/></svg>
                {%- endcase -%}
              </div>
            {%- endif -%}
            <div>
              {%- if block.settings.title != blank -%}
                <div class="mf25-conf-key">{{ block.settings.title | escape }}</div>
              {%- endif -%}
              {%- if block.settings.sub != blank -%}
                <p class="mf25-conf-sub">{{ block.settings.sub | escape }}</p>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "MF25 Stitch Confidence",
  "tag": "section",
  "class": "section-mf25-stitch-confidence",
  "settings": [
    { "type": "text", "id": "title", "label": "Title (optional, blank = no heading)" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Trust item",
      "limit": 6,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "shield", "label": "Warranty / shield" },
            { "value": "truck", "label": "Shipping / truck" },
            { "value": "headset", "label": "Customer service / headset" },
            { "value": "none", "label": "None (no icon)" }
          ],
          "default": "shield"
        },
        { "type": "text", "id": "title", "label": "Title", "default": "1-Year Warranty" },
        { "type": "textarea", "id": "sub", "label": "Description" }
      ]
    }
  ],
  "presets": [
    {
      "name": "MF25 Stitch Confidence",
      "blocks": [
        { "type": "item", "settings": { "icon": "shield", "title": "1-Year Warranty", "sub": "Frame, motor, battery, and electronics covered. Real humans in California answer the phone." } },
        { "type": "item", "settings": { "icon": "truck", "title": "Free Shipping", "sub": "FedEx ground included on every order in the contiguous US. No surcharge for accessories." } },
        { "type": "item", "settings": { "icon": "headset", "title": "Customer Service", "sub": "Real support in California — help with assembly, service, and answers whenever you need us." } }
      ]
    }
  ]
}
{% endschema %}
