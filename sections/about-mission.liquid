{%- liquid
  assign s = section.settings
-%}

<section class="about-mission{% if s.bg_image == blank and s.bg_video_url == blank %} about-mission--no-bg{% endif %}" {{ section.shopify_attributes }}>
  {%- if s.bg_video_url != blank -%}
    <div class="about-mission__bg" aria-hidden="true">
      <video
        src="{{ s.bg_video_url }}"
        {% if s.bg_image != blank %}poster="{{ s.bg_image | image_url: width: 1920 }}"{% endif %}
        autoplay muted loop playsinline preload="metadata"></video>
    </div>
    <div class="about-mission__overlay" aria-hidden="true"></div>
  {%- elsif s.bg_image != blank -%}
    <div class="about-mission__bg" aria-hidden="true">
      <img
        src="{{ s.bg_image | image_url: width: 1920 }}"
        srcset="{{ s.bg_image | image_url: width: 960 }} 960w, {{ s.bg_image | image_url: width: 1280 }} 1280w, {{ s.bg_image | image_url: width: 1920 }} 1920w, {{ s.bg_image | image_url: width: 2560 }} 2560w"
        sizes="100vw"
        alt=""
        loading="lazy">
    </div>
    <div class="about-mission__overlay" aria-hidden="true"></div>
  {%- endif -%}

  <div class="container about-mission__inner">
    <span class="about-mission__bar" aria-hidden="true"></span>

    {%- if s.eyebrow != blank -%}
      <span class="about-mission__eyebrow">{{ s.eyebrow }}</span>
    {%- endif -%}

    {%- if s.heading != blank -%}
      <h1 class="about-mission__heading">{{ s.heading | newline_to_br }}</h1>
    {%- endif -%}

    {%- if s.body != blank -%}
      <div class="about-mission__body">{{ s.body }}</div>
    {%- endif -%}

    {%- if s.closing != blank -%}
      <p class="about-mission__closing">{{ s.closing }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{ "name": "About Mission", "tag": "section", "class": "section-about-mission", "settings": [ { "type": "header", "content": "Mission statement" }, { "type": "text", "id": "eyebrow", "label": "Eyebrow (small caps)", "default": "Our Mission" }, { "type": "textarea", "id": "heading", "label": "Heading (big H1)", "info": "Big statement shown in display font. Use <br> for line breaks." }, { "type": "richtext", "id": "body", "label": "Mission body (expanded statement)", "info": "Shown as a large H2 below the heading." }, { "type": "textarea", "id": "closing", "label": "Closing line (optional)", "info": "A short closing line shown below the mission body." }, { "type": "header", "content": "Background (image OR video)" }, { "type": "image_picker", "id": "bg_image", "label": "Background image / video poster", "info": "Recommended: 1920x1080 (16:9), JPG/PNG, <500KB." }, { "type": "text", "id": "bg_video_url", "label": "Background video URL (mp4)", "info": "Recommended: 1920x1080 mp4, H.264, <10MB. Takes priority over image." } ], "presets": [ { "name": "About Mission", "settings": { "eyebrow": "Our Mission", "heading": "Provide more U.S. riders with<br>electric mobility<br>that makes sense.", "body": "<p>From seniors reclaiming their daily independence to families exploring together — we build electric trikes that solve real problems at honest prices.</p>", "closing": "This is what keeps us moving forward." } } ] }
{% endschema %}