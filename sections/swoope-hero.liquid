{% render 'swoope-styles' %}
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign s = section.settings
  assign current_variant = product.selected_or_first_available_variant
  assign has_compare = false
  if current_variant.compare_at_price > current_variant.price
    assign has_compare = true
  endif
  assign s_count = 0
  for block in section.blocks
    if block.type == 'spec'
      assign s_count = s_count | plus: 1
    endif
  endfor

  # Color family resolution: if the product has a `product_family` metaobject
  # with >1 members, the Color row becomes an external-link swatch row
  # (each member is a separate Product — click = navigate to that PDP).
  # Otherwise, fall back to in-page Color variant swatches (radio inputs).
  assign family_members = blank
  assign product_family = product.metafields.custom.product_family.value
  if product_family and product_family.members.value.size > 1
    assign family_members = product_family.members.value
  endif
-%}

<style>
.sw-hero{position:relative;min-height:760px;padding-top:96px;display:flex;align-items:center;background:var(--sw-surface-0);overflow:hidden}
.sw-hero-bg{position:absolute;inset:0;background-color:var(--sw-surface-0);z-index:0}
.sw-hero-bg img{position:absolute;left:5%;bottom:5%;width:55%;max-width:780px;height:auto;object-fit:contain;z-index:1}
.sw-hero-bg::after{content:"";position:absolute;inset:0;background:linear-gradient(to right,transparent 0%,rgba(19,19,19,0.6) 40%,var(--sw-surface-0) 75%);z-index:2}
.sw-hero-inner{position:relative;z-index:3;width:100%;max-width:var(--sw-container);margin:0 auto;padding:0 var(--sw-gutter);display:flex;justify-content:flex-end}
.sw-hero-card{width:100%;max-width:520px;background:rgba(46,46,46,0.4);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);border:1px solid rgba(255,255,255,0.1);border-radius:var(--sw-r-xl);padding:40px;box-shadow:0 24px 48px rgba(0,0,0,0.4)}
.sw-hero-name{font-family:var(--sw-display);font-size:clamp(56px,7vw,80px);font-weight:800;line-height:1;letter-spacing:-0.04em;color:var(--sw-lime);margin:0 0 16px}
.sw-hero-price-row{display:flex;align-items:baseline;gap:12px;flex-wrap:wrap;margin-bottom:8px}
.sw-hero-price{font-family:var(--sw-display);font-size:clamp(36px,4vw,48px);font-weight:700;line-height:1.1;letter-spacing:-0.02em;color:var(--sw-on-surface);margin:0}
.sw-hero-price--compare{font-family:var(--sw-mono);font-size:20px;font-weight:500;color:var(--sw-on-surface-variant);text-decoration:line-through;opacity:0.7}
.sw-hero-badge-on-sale{display:inline-block;font-family:var(--sw-mono);font-size:11px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;padding:4px 8px;background:var(--sw-lime);color:var(--sw-on-lime);border-radius:var(--sw-r-sm)}
.sw-hero-desc{font-family:var(--sw-body);font-size:16px;line-height:1.6;color:var(--sw-on-surface-variant);margin:0 0 40px}
.sw-hero-specs{display:flex;flex-direction:column;gap:24px;margin-bottom:32px}
.sw-hero-spec{display:flex;align-items:center;gap:16px;padding-bottom:24px;border-bottom:1px solid rgba(255,255,255,0.1)}
.sw-hero-spec:last-child{border-bottom:0;padding-bottom:0}
.sw-hero-spec-icon{color:var(--sw-lime);width:32px;height:32px;flex:0 0 32px;display:inline-flex;align-items:center;justify-content:center}
.sw-hero-spec-icon svg{width:100%;height:100%;display:block}
.sw-hero-spec-meta .sw-spec-value{margin-bottom:2px}
.sw-hero-config{background:rgba(32,31,31,0.6);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);border-radius:var(--sw-r-lg);border:1px solid var(--sw-surface-highest);padding:24px}
.sw-hero-config-title{font-family:var(--sw-display);font-size:24px;font-weight:600;line-height:1.3;color:var(--sw-on-surface);margin:0 0 24px}
.sw-hero-config-row{margin-bottom:24px}
.sw-hero-config-row:last-of-type{margin-bottom:0}
.sw-hero-config-label{font-family:var(--sw-mono);font-size:14px;font-weight:500;letter-spacing:0.05em;text-transform:uppercase;color:var(--sw-on-surface-variant);margin:0 0 12px;display:flex;gap:8px;align-items:baseline}
.sw-hero-config-label .sw-current{color:var(--sw-on-surface);font-weight:700}
/* variant swatch row */
.sw-hero-swatches{display:flex;flex-wrap:wrap;gap:12px}
.sw-hero-swatch{position:relative;display:inline-flex;align-items:center;gap:8px;padding:6px 12px 6px 6px;border-radius:999px;border:1px solid rgba(255,255,255,0.1);background:rgba(46,46,46,0.4);cursor:pointer;transition:border-color .15s,background .15s;text-decoration:none;color:inherit}
.sw-hero-swatch:hover{border-color:rgba(195,244,0,0.4)}
.sw-hero-swatch input{position:absolute;opacity:0;pointer-events:none}
.sw-hero-swatch-dot{width:20px;height:20px;border-radius:50%;border:1px solid rgba(255,255,255,0.15);flex:0 0 20px}
.sw-hero-swatch-name{font-family:var(--sw-mono);font-size:13px;font-weight:500;letter-spacing:0.05em;text-transform:uppercase;color:var(--sw-on-surface)}
.sw-hero-swatch input:checked + .sw-hero-swatch-dot{box-shadow:0 0 0 2px var(--sw-surface-0),0 0 0 4px var(--sw-lime)}
.sw-hero-swatch input:checked ~ .sw-hero-swatch-name{color:var(--sw-lime)}
/* family swatches (external links) — small filled card with dot + name */
.sw-hero-swatches--family{flex-wrap:wrap;gap:10px}
.sw-hero-swatches--family .sw-hero-swatch{flex-direction:row;align-items:center;gap:10px;padding:8px 14px 8px 8px;border-radius:999px;background:rgba(32,31,31,0.6);border:1px solid rgba(255,255,255,0.08);transition:border-color .15s,background .15s,transform .1s}
.sw-hero-swatches--family .sw-hero-swatch:hover{border-color:rgba(195,244,0,0.35);background:rgba(46,46,46,0.55)}
.sw-hero-swatches--family .sw-hero-swatch:active{transform:scale(0.97)}
.sw-hero-swatches--family .sw-hero-swatch-dot{width:28px;height:28px;border:1px solid rgba(255,255,255,0.12);transition:border-color .15s,box-shadow .15s;flex:0 0 28px}
.sw-hero-swatches--family .sw-hero-swatch:hover .sw-hero-swatch-dot{border-color:var(--sw-lime)}
.sw-hero-swatches--family .sw-hero-swatch-name{font-family:var(--sw-mono);font-size:11px;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:var(--sw-on-surface);white-space:nowrap;max-width:160px;overflow:hidden;text-overflow:ellipsis}
.sw-hero-swatch--current{cursor:default;pointer-events:none;border-color:rgba(195,244,0,0.4);background:rgba(195,244,0,0.08)}
.sw-hero-swatch--current:hover{border-color:rgba(195,244,0,0.4);background:rgba(195,244,0,0.08)}
.sw-hero-swatch--current .sw-hero-swatch-dot{border-color:var(--sw-lime);box-shadow:0 0 0 2px var(--sw-surface-0),0 0 0 4px var(--sw-lime)}
.sw-hero-swatch--current .sw-hero-swatch-name{color:var(--sw-lime)}
/* option dropdown (non-color) */
.sw-hero-select-wrap{position:relative}
.sw-hero-select{width:100%;appearance:none;-webkit-appearance:none;background:rgba(46,46,46,0.4);border:1px solid rgba(255,255,255,0.1);border-radius:var(--sw-r);color:var(--sw-on-surface);font-family:var(--sw-mono);font-size:13px;font-weight:500;letter-spacing:0.05em;text-transform:uppercase;padding:12px 40px 12px 14px;cursor:pointer}
.sw-hero-select:focus{outline:none;border-color:var(--sw-lime);box-shadow:0 0 0 2px rgba(195,244,0,0.25)}
.sw-hero-select-arrow{position:absolute;right:14px;top:50%;transform:translateY(-50%);color:var(--sw-on-surface-variant);pointer-events:none}
.sw-hero-select-arrow svg{width:14px;height:14px;display:block}
/* qty row */
.sw-hero-qty-row{display:flex;align-items:center;gap:12px;margin-bottom:16px}
.sw-hero-qty{display:inline-flex;align-items:center;background:rgba(46,46,46,0.4);border:1px solid rgba(255,255,255,0.1);border-radius:var(--sw-r);overflow:hidden}
.sw-hero-qty button{width:36px;height:36px;color:var(--sw-on-surface);font-size:18px;line-height:1;display:grid;place-items:center}
.sw-hero-qty button:hover{background:rgba(195,244,0,0.1);color:var(--sw-lime)}
.sw-hero-qty input{width:48px;height:36px;background:transparent;border:0;border-left:1px solid rgba(255,255,255,0.1);border-right:1px solid rgba(255,255,255,0.1);color:var(--sw-on-surface);font-family:var(--sw-mono);font-size:14px;text-align:center;-moz-appearance:textfield}
.sw-hero-qty input::-webkit-outer-spin-button,.sw-hero-qty input::-webkit-inner-spin-button{-webkit-appearance:none;margin:0}
.sw-hero-stock{font-family:var(--sw-mono);font-size:12px;letter-spacing:0.05em;text-transform:uppercase;color:var(--sw-on-surface-variant);margin-bottom:16px}
.sw-hero-stock--out{color:#ff8a80}
.sw-hero-stock--low{color:var(--sw-lime)}
.sw-hero-actions{display:flex;flex-direction:column;gap:12px}
.sw-hero-actions .sw-btn{position:relative}
.sw-hero-submit-state{display:none}
.sw-hero-submit-state.is-loading{display:inline-flex;align-items:center;gap:8px}
.sw-hero-submit-state .spinner{width:14px;height:14px;border:2px solid currentColor;border-right-color:transparent;border-radius:50%;animation:sw-spin .6s linear infinite}
@keyframes sw-spin{to{transform:rotate(360deg)}}
.sw-hero-err{min-height:18px;font-family:var(--sw-mono);font-size:12px;color:#ff8a80;margin-top:8px}
@media (max-width:960px){
  .sw-hero{min-height:auto;padding:120px 0 64px}
  .sw-hero-bg img{opacity:0.3;left:50%;transform:translateX(-50%)}
  .sw-hero-bg::after{background:linear-gradient(180deg,rgba(10,10,10,0.7) 0%,var(--sw-surface-0) 80%)}
  .sw-hero-inner{justify-content:center}
  .sw-hero-card{max-width:100%;padding:28px}
  .sw-hero-desc{margin-bottom:32px}
  .sw-hero-specs{gap:20px;margin-bottom:28px}
}
</style>

{%- comment -%}
  Variant data exposed to JS: full map so client-side switching can update
  price + availability + button state without a server round-trip.
{%- endcomment -%}
<script type="application/json" data-swoope-variants>
  {
    "productId": {{ product.id | json }},
    "familySize": {% if family_members != blank %}{{ family_members | size }}{% else %}0{% endif %},
    "variants": [
      {%- for v in product.variants -%}
        {
          "id": {{ v.id | json }},
          "available": {{ v.available | json }},
          "price": {{ v.price | json }},
          "compareAtPrice": {{ v.compare_at_price | json }},
          "priceFormatted": {{ v.price | money | json }},
          "compareAtPriceFormatted": {{ v.compare_at_price | money | json }},
          "options": {{ v.options | json }},
          "featuredImage": {% if v.featured_image %}{{ v.featured_image | image_url: width: 1600 | json }}{% else %}null{% endif %}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ],
    "options": [
      {%- for opt in product.options_with_values -%}
        {
          "name": {{ opt.name | json }},
          "position": {{ opt.position | json }},
          "values": {{ opt.values | json }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ],
    "bgImage": {% if s.bg_image %}{{ s.bg_image | image_url: width: 1600 | json }}{% elsif product.featured_image %}{{ product.featured_image | image_url: width: 1600 | json }}{% else %}null{% endif %},
    "currency": {{ shop.currency | json }}
  }
</script>

<section class="sw-hero" style="padding-top:{{ s.padding_top | default: 96 }}px;padding-bottom:{{ s.padding_bottom | default: 96 }}px" {{ section.shopify_attributes }}>
  <div class="sw-hero-bg" data-hero-bg>
    {%- if s.bg_image != blank -%}
      <img src="{{ s.bg_image | image_url: width: 1600 }}" alt="{{ product.title | escape }}" loading="eager" width="1600" height="1067" data-hero-bg-img>
    {%- elsif product.featured_image -%}
      <img src="{{ product.featured_image | image_url: width: 1600 }}" alt="{{ product.title | escape }}" loading="eager" width="1600" height="1067" data-hero-bg-img>
    {%- endif -%}
  </div>

  <div class="sw-hero-inner">
    <div class="sw-hero-card">
      {%- liquid
        assign hero_title = s.heading_override | default: product.title
        assign hero_desc = s.description_override | default: product.description
      -%}
      <h1 class="sw-hero-name" data-hero-name>{{ hero_title | escape }}</h1>

      <div class="sw-hero-price-row">
        <p class="sw-hero-price" data-hero-price>{{ current_variant.price | money }}</p>
        {%- if has_compare -%}
          <s class="sw-hero-price--compare" data-hero-compare>{{ current_variant.compare_at_price | money }}</s>
          <span class="sw-hero-badge-on-sale">On Sale</span>
        {%- endif -%}
      </div>

      {%- if hero_desc != blank -%}
        <div class="sw-hero-desc" data-hero-desc>{{ hero_desc }}</div>
      {%- endif -%}

      {%- if s_count > 0 -%}
        <div class="sw-hero-specs">
          {%- for block in section.blocks -%}
            {%- if block.type == 'spec' -%}
              <div class="sw-hero-spec" {{ block.shopify_attributes }}>
                <span class="sw-hero-spec-icon">
                  {%- case block.settings.icon -%}
                    {%- when 'bolt' -%}
                      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13 2L3 14h7l-1 8 10-12h-7l1-8z"/></svg>
                    {%- when 'route' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="6" cy="19" r="3"/><path d="M9 19h8.5a3.5 3.5 0 0 0 0-7h-11a3.5 3.5 0 0 1 0-7H15"/><circle cx="18" cy="5" r="3"/></svg>
                    {%- when 'weight' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6.5 6.5h11l2 14a2 2 0 0 1-2 2h-11a2 2 0 0 1-2-2l2-14z"/><circle cx="12" cy="4" r="2"/><path d="M12 6v2"/></svg>
                    {%- when 'speed' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 14l4-4"/><path d="M3.34 19a10 10 0 1 1 17.32 0"/></svg>
                    {%- else -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/></svg>
                  {%- endcase -%}
                </span>
                <div class="sw-hero-spec-meta">
                  <p class="sw-spec-value">{{ block.settings.value | escape }}</p>
                  <p class="sw-spec-label">{{ block.settings.label | escape }}</p>
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      <div class="sw-hero-config">
        <h3 class="sw-hero-config-title">Configure Your Ride</h3>

        {%- if product.has_only_default_variant == false -%}
          <product-form class="product-form" data-hide-errors="true">
            {%- form 'product', product, id: 'swoope-hero__form', class: 'pdp__form swoope-hero__form', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
              <input type="hidden" name="id" value="{{ current_variant.id }}" disabled class="product-variant-id" data-variant-input>

              {%- for option in product.options_with_values -%}
                {%- assign opt_handle = option.name | downcase | handleize -%}
                {%- assign is_color = false -%}
                {%- if opt_handle == 'color' or opt_handle == 'colour' -%}
                  {%- assign is_color = true -%}
                {%- endif -%}
                {%- assign opt_pos = forloop.index0 -%}
                <div class="sw-hero-config-row">
                  <p class="sw-hero-config-label">
                    {{ option.name }}:
                    <span class="sw-current" data-option-label="{{ opt_pos }}">
                      {%- if is_color and family_members != blank -%}
                        {%- for member in family_members -%}
                          {%- if member.id == product.id -%}
                            {%- assign member_color_name = member.metafields.custom.color_name -%}
                            {%- if member_color_name == blank -%}{%- assign member_color_name = member.title -%}{%- endif -%}
                            {% render 'swoope-color-short', name: member_color_name %}
                          {%- endif -%}
                        {%- endfor -%}
                      {%- else -%}
                        {{ option.selected_value }}
                      {%- endif -%}
                    </span>
                  </p>

                  {%- if is_color and family_members != blank -%}
                    {%- comment -%}
                      Color family: each member is a separate product, swatches
                      are external <a> links to member.url. Current product is
                      rendered as a non-clickable <span> with ring.
                    {%- endcomment -%}
                    <div class="sw-hero-swatches sw-hero-swatches--family" role="list">
                      {%- for member in family_members -%}
                        {%- liquid
                          assign member_color_name = member.metafields.custom.color_name
                          if member_color_name == blank
                            assign member_color_name = member.title
                          endif

                          # color resolution: hex metafield → keyword match → featured_image → neutral
                          assign member_hex = member.metafields.custom.color_hex
                          assign use_image = false
                          assign member_image_url = blank
                          if member_hex == blank
                            assign m_lower = member_color_name | downcase
                            if m_lower contains 'lime' or m_lower contains 'electric-lime'
                              assign member_hex = '#abd600'
                            elsif m_lower contains 'phantom' or m_lower contains 'black'
                              assign member_hex = '#0e0e0e'
                            elsif m_lower contains 'slate' or m_lower contains 'gray' or m_lower contains 'grey'
                              assign member_hex = '#474747'
                            elsif m_lower contains 'white'
                              assign member_hex = '#ffffff'
                            elsif m_lower contains 'red'
                              assign member_hex = '#d32f2f'
                            elsif m_lower contains 'orange'
                              assign member_hex = '#ff6b1a'
                            elsif m_lower contains 'blue'
                              assign member_hex = '#1976d2'
                            endif
                          endif
                          if member_hex == blank and member.featured_image != blank
                            assign member_image_url = member.featured_image | image_url: width: 120
                            assign use_image = true
                          elsif member_hex == blank
                            assign member_hex = '#888888'
                          endif

                          assign is_current = false
                          if member.id == product.id
                            assign is_current = true
                          endif
                        -%}
                        {%- if is_current -%}
                          <span class="sw-hero-swatch sw-hero-swatch--current"
                                data-swatch="{{ member.handle }}"
                                title="{{ member_color_name | escape }}"
                                aria-current="page"
                                aria-label="{{ member_color_name | escape }}">
                            {%- if use_image -%}
                              <span class="sw-hero-swatch-dot sw-hero-swatch-dot--image" style="background-image:url('{{ member_image_url }}');background-size:cover;background-position:center"></span>
                            {%- else -%}
                              <span class="sw-hero-swatch-dot" style="background:{{ member_hex }};{% if member_hex == '#ffffff' %}border:1px solid rgba(255,255,255,0.25){% endif %}"></span>
                            {%- endif -%}
                            <span class="sw-hero-swatch-name">{% render 'swoope-color-short', name: member_color_name %}</span>
                          </span>
                        {%- else -%}
                          <a class="sw-hero-swatch"
                             href="{{ member.url }}"
                             data-swatch="{{ member.handle }}"
                             title="{{ member_color_name | escape }}"
                             aria-label="{{ member_color_name | escape }}">
                            {%- if use_image -%}
                              <span class="sw-hero-swatch-dot sw-hero-swatch-dot--image" style="background-image:url('{{ member_image_url }}');background-size:cover;background-position:center"></span>
                            {%- else -%}
                              <span class="sw-hero-swatch-dot" style="background:{{ member_hex }};{% if member_hex == '#ffffff' %}border:1px solid rgba(255,255,255,0.25){% endif %}"></span>
                            {%- endif -%}
                            <span class="sw-hero-swatch-name">{% render 'swoope-color-short', name: member_color_name %}</span>
                          </a>
                        {%- endif -%}
                      {%- endfor -%}
                    </div>
                  {%- elsif is_color -%}
                    {%- comment -%}
                      No product_family set up yet: fall back to in-page Color
                      variant radio swatches so the section still works while
                      family is being configured in admin.
                    {%- endcomment -%}
                    <div class="sw-hero-swatches" role="radiogroup" aria-label="{{ option.name | escape }}">
                      {%- for value in option.values -%}
                        {%- assign variant = nil -%}
                        {%- for v in product.variants -%}
                          {%- if v.options[opt_pos] == value -%}
                            {%- assign variant = v -%}
                            {%- break -%}
                          {%- endif -%}
                        {%- endfor -%}
                        {%- assign swatch_hex = blank -%}
                        {%- if variant and variant.metafields.custom.color_hex != blank -%}
                          {%- assign swatch_hex = variant.metafields.custom.color_hex -%}
                        {%- else -%}
                          {%- assign sn = value | downcase | handleize -%}
                          {%- case sn -%}
                            {%- when 'black','phantom-black' -%}{%- assign swatch_hex = '#0e0e0e' -%}
                            {%- when 'lime','electric-lime' -%}{%- assign swatch_hex = '#abd600' -%}
                            {%- when 'slate','slate-grey','gray','grey' -%}{%- assign swatch_hex = '#474747' -%}
                            {%- when 'white' -%}{%- assign swatch_hex = '#ffffff' -%}
                            {%- when 'red' -%}{%- assign swatch_hex = '#d32f2f' -%}
                            {%- when 'blue' -%}{%- assign swatch_hex = '#1976d2' -%}
                            {%- else -%}{%- assign swatch_hex = '#888888' -%}
                          {%- endcase -%}
                        {%- endif -%}
                        <label class="sw-hero-swatch" title="{{ value | escape }}">
                          <input type="radio" name="options[{{ option.name | downcase }}]" value="{{ value }}" {% if option.selected_value == value %}checked{% endif %} data-option-index="{{ opt_pos }}" data-variant-id="{{ variant.id | default: '' }}">
                          <span class="sw-hero-swatch-dot" style="background:{{ swatch_hex }};{% if swatch_hex == '#ffffff' %}border:1px solid rgba(255,255,255,0.2){% endif %}"></span>
                          <span class="sw-hero-swatch-name">{{ value | escape }}</span>
                        </label>
                      {%- endfor -%}
                    </div>
                  {%- else -%}
                    <div class="sw-hero-select-wrap">
                      <select name="options[{{ option.name | downcase }}]" class="sw-hero-select" data-option-index="{{ opt_pos }}">
                        {%- for value in option.values -%}
                          {%- assign variant = nil -%}
                          {%- for v in product.variants -%}
                            {%- if v.options[opt_pos] == value -%}
                              {%- assign variant = v -%}
                              {%- break -%}
                            {%- endif -%}
                          {%- endfor -%}
                          <option value="{{ value }}" {% if option.selected_value == value %}selected{% endif %} data-variant-id="{{ variant.id | default: '' }}">{{ value | escape }}</option>
                        {%- endfor -%}
                      </select>
                      <span class="sw-hero-select-arrow" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg></span>
                    </div>
                  {%- endif -%}
                </div>
              {%- endfor -%}

              <div class="sw-hero-qty-row">
                <div class="sw-hero-qty" data-qty>
                  <button type="button" data-qty-step="-1" aria-label="Decrease quantity">&minus;</button>
                  <input type="number" name="quantity" value="1" min="1" data-qty-input aria-label="Quantity">
                  <button type="button" data-qty-step="1" aria-label="Increase quantity">&plus;</button>
                </div>
              </div>

              <div class="sw-hero-actions">
                <button type="submit" name="add" class="sw-btn sw-btn--primary" data-add-to-cart {% unless current_variant.available %}disabled{% endunless %}>
                  <span data-add-label>
                    {%- if current_variant.available -%}
                      {%- if product.template_suffix == 'electric-dirt-bike' -%}
                        Reserve Now &mdash; {{ current_variant.price | money }}
                      {%- else -%}
                        Add to Cart &mdash; {{ current_variant.price | money }}
                      {%- endif -%}
                    {%- else -%}
                      Sold Out
                    {%- endif -%}
                  </span>
                  <span class="sw-hero-submit-state" data-add-spinner><span class="spinner"></span><span>Adding</span></span>
                </button>
                {%- if s.show_dynamic_checkout and current_variant.available -%}
                  <div class="sw-hero-dynamic-checkout">{{ form | payment_button }}</div>
                {%- endif -%}
                {%- if s.dealer_link != blank -%}
                  <a href="{{ s.dealer_link }}" class="sw-btn sw-btn--ghost">Find a Dealer</a>
                {%- endif -%}
              </div>

              <div class="sw-hero-err" data-add-error role="alert"></div>
            {%- endform -%}
          </product-form>
        {%- else -%}
          {%- comment -%}
            Product has no variants — still render the buy form with just qty
          {%- endcomment -%}
          <product-form class="product-form" data-hide-errors="true">
            {%- form 'product', product, id: 'swoope-hero__form', class: 'pdp__form swoope-hero__form', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
              <input type="hidden" name="id" value="{{ current_variant.id }}" disabled class="product-variant-id" data-variant-input>

              <div class="sw-hero-qty-row">
                <div class="sw-hero-qty" data-qty>
                  <button type="button" data-qty-step="-1" aria-label="Decrease quantity">&minus;</button>
                  <input type="number" name="quantity" value="1" min="1" data-qty-input aria-label="Quantity">
                  <button type="button" data-qty-step="1" aria-label="Increase quantity">&plus;</button>
                </div>
              </div>

              <div class="sw-hero-actions">
                <button type="submit" name="add" class="sw-btn sw-btn--primary" data-add-to-cart {% unless current_variant.available %}disabled{% endunless %}>
                  <span data-add-label>
                    {%- if current_variant.available -%}
                      Reserve Now &mdash; {{ current_variant.price | money }}
                    {%- else -%}
                      Sold Out
                    {%- endif -%}
                  </span>
                  <span class="sw-hero-submit-state" data-add-spinner><span class="spinner"></span><span>Adding</span></span>
                </button>
                {%- if s.show_dynamic_checkout and current_variant.available -%}
                  <div class="sw-hero-dynamic-checkout">{{ form | payment_button }}</div>
                {%- endif -%}
                {%- if s.dealer_link != blank -%}
                  <a href="{{ s.dealer_link }}" class="sw-btn sw-btn--ghost">Find a Dealer</a>
                {%- endif -%}
              </div>

              <div class="sw-hero-err" data-add-error role="alert"></div>
            {%- endform -%}
          </product-form>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

<script>
(function(){
  // --- Variant switching (scoped to swoope-hero) ---
  var card = document.querySelector('.section-swoope-hero .sw-hero-card');
  if (!card) return;
  var dataEl = document.querySelector('[data-swoope-variants]');
  if (!dataEl) return;
  var data = JSON.parse(dataEl.textContent || '{}');
  var variants = data.variants || [];
  var priceEl = card.querySelector('[data-hero-price]');
  var compareEl = card.querySelector('[data-hero-compare]');
  var bgImg = document.querySelector('[data-hero-bg-img]');
  var qtyEl = card.querySelector('[data-qty]');

  // Non-color option positions. Color is external-link when product_family
  // has members (each member is a separate product — click = navigate), so we
  // never include it in the in-page variant matcher. When no family exists,
  // Color is an in-page radio and IS included.
  function nonColorPositions(){
    var out = [];
    data.options.forEach(function(o, i){
      var h = (o.name || '').toLowerCase().replace(/[^a-z0-9]/g,'');
      var skip = (h === 'color' || h === 'colour');
      if (data.familySize > 1 && skip) return;
      out.push(i);
    });
    return out;
  }
  var ncPos = nonColorPositions();

  function getSelectedNonColorOptions(){
    var form = card.querySelector('#swoope-hero__form');
    if (!form) return [];
    var inputs = form.querySelectorAll('input[type="radio"]:checked, select');
    var out = [];
    inputs.forEach(function(el){
      var idx = parseInt(el.dataset.optionIndex || '-1', 10);
      if (ncPos.indexOf(idx) >= 0) out.push({ idx: idx, value: el.value });
    });
    out.sort(function(a, b){ return a.idx - b.idx; });
    return out.map(function(o){ return o.value; });
  }

  function findVariantByNonColorOptions(values){
    return variants.find(function(v){
      return ncPos.every(function(pos, i){
        return v.options[pos] === values[i];
      });
    });
  }

  function applyVariant(v){
    var form = card.querySelector('#swoope-hero__form');
    var idInput = form && form.querySelector('[data-variant-input]');
    var addBtn = card.querySelector('[data-add-to-cart]');
    var labelEl = card.querySelector('[data-add-label]');
    if (!v) return;
    if (idInput) idInput.value = v.id;
    if (priceEl) priceEl.textContent = v.priceFormatted;
    if (compareEl){
      if (v.compareAtPrice && v.compareAtPrice > v.price){
        compareEl.textContent = v.compareAtPriceFormatted;
        compareEl.style.display = '';
      } else {
        compareEl.style.display = 'none';
      }
    }
    if (bgImg && v.featuredImage){
      bgImg.src = v.featuredImage;
    }
    if (addBtn && labelEl){
      if (v.available){
        addBtn.disabled = false;
        labelEl.textContent = 'Reserve Now — ' + v.priceFormatted;
      } else {
        addBtn.disabled = true;
        labelEl.textContent = 'Sold Out';
      }
    }
  }

  // Listen for option changes (only non-color ones drive variant switching)
  var form = card.querySelector('#swoope-hero__form');
  if (form){
    form.addEventListener('change', function(e){
      if (!e.target.matches('input[type=radio], select')) return;
      var idx = parseInt(e.target.dataset.optionIndex || '-1', 10);
      // Always update the label for whichever option changed
      var labelEl = card.querySelector('[data-option-label="' + idx + '"]');
      if (labelEl) labelEl.textContent = e.target.value;
      // Only re-resolve variant on non-color option changes
      if (ncPos.indexOf(idx) < 0) return;
      var opts = getSelectedNonColorOptions();
      if (opts.length === ncPos.length){
        var v = findVariantByNonColorOptions(opts);
        if (v) applyVariant(v);
      }
    });
  }

  // --- Quantity stepper ---
  if (qtyEl){
    var input = qtyEl.querySelector('[data-qty-input]');
    qtyEl.addEventListener('click', function(e){
      var step = parseInt(e.target.dataset.qtyStep || '0', 10);
      if (!step || !input) return;
      var cur = parseInt(input.value, 10) || 1;
      var next = Math.max(1, cur + step);
      input.value = next;
    });
  }

  // --- Add-to-cart submit state ---
  var submitBtn = card.querySelector('[data-add-to-cart]');
  var spinner = card.querySelector('[data-add-spinner]');
  var errEl = card.querySelector('[data-add-error]');
  if (submitBtn){
    submitBtn.addEventListener('click', function(){
      submitBtn.classList.add('is-loading');
      if (spinner) spinner.classList.add('is-loading');
      if (errEl) errEl.textContent = '';
      // product-form.js handles the actual submit; reset state after a tick
      setTimeout(function(){
        submitBtn.classList.remove('is-loading');
        if (spinner) spinner.classList.remove('is-loading');
      }, 1200);
    });
  }
  // Catch cart error events from product-form.js via pubsub
  if (typeof subscribe === 'function' && typeof window.PUB_SUB_EVENTS !== 'undefined' && errEl){
    subscribe(window.PUB_SUB_EVENTS.cartError, function(data){
      if (data && data.message){
        errEl.textContent = data.message;
      }
    });
  }
})();
</script>

{% schema %}
{
  "name": "SWOOPE Hero",
  "tag": "section",
  "class": "section-swoope-hero",
  "settings": [
    { "type": "header", "content": "Product overrides (blank = use product data)" },
    { "type": "text", "id": "heading_override", "label": "Heading override",
      "info": "Leave blank to use product.title." },
    { "type": "richtext", "id": "description_override", "label": "Description override",
      "info": "Leave blank to use product.description." },
    { "type": "image_picker", "id": "bg_image", "label": "Background bike image override",
      "info": "Recommended: 1600×1067 (3:2). Falls back to product.featured_image. <300KB." },
    { "type": "header", "content": "Calls to action" },
    { "type": "url", "id": "dealer_link", "label": "Find a Dealer link (optional)" },
    { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Show dynamic checkout button", "default": true },
    { "type": "header", "content": "Section spacing" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 96 }
  ],
  "blocks": [
    {
      "type": "spec",
      "name": "Hero spec (decoration)",
      "limit": 6,
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon",
          "options": [
            { "value": "bolt",   "label": "Bolt (power)" },
            { "value": "route",  "label": "Route (range)" },
            { "value": "weight", "label": "Weight (mass)" },
            { "value": "speed",  "label": "Speed (top)" },
            { "value": "none",   "label": "Other (generic circle)" }
          ],
          "default": "bolt" },
        { "type": "text", "id": "value", "label": "Value (display)", "default": "80 HP" },
        { "type": "text", "id": "label", "label": "Label (uppercase)", "default": "Peak Power" }
      ]
    }
  ],
  "presets": [
    {
      "name": "SWOOPE Hero",
      "blocks": [
        { "type": "spec", "settings": { "icon": "bolt",   "value": "80 HP",   "label": "Peak Power" } },
        { "type": "spec", "settings": { "icon": "route",  "value": "60 Miles","label": "Max Range" } },
        { "type": "spec", "settings": { "icon": "weight", "value": "240 lbs", "label": "Curb Weight" } }
      ]
    }
  ]
}
{% endschema %}