
{% render 'mf25-stitch-styles' %}

{%- liquid
  assign s = section.settings
-%}

<section class="mf25-specs" style="padding-top:{{ s.padding_top }}px;padding-bottom:{{ s.padding_bottom }}px" {{ section.shopify_attributes }}>
  <div class="container">
    <div class="mf25-specs-head">
      <h2>{{ s.title }}</h2>
    </div>
    <div class="mf25-specs-grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'category' -%}
          <div class="mf25-spec-card" {{ block.shopify_attributes }}>
            <div class="mf25-spec-card-head">
              {%- case block.settings.icon -%}
                {%- when 'frame' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="18.5" cy="17.5" r="3.5"/><circle cx="5.5" cy="17.5" r="3.5"/><circle cx="15" cy="5" r="1"/><path d="M12 17.5V14l-3-3 4-3 2 3h2"/></svg>
                {%- when 'battery' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="2" y="7" width="16" height="10" rx="2"/><line x1="22" y1="11" x2="22" y2="13"/><line x1="6" y1="10" x2="6" y2="14"/><line x1="10" y1="10" x2="10" y2="14"/><line x1="14" y1="10" x2="14" y2="14"/></svg>
                {%- when 'motor' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/></svg>
                {%- when 'wheel' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="1.5"/><path d="M12 3v6M12 15v6M3 12h6M15 12h6M5.6 5.6l3.5 3.5M14.9 14.9l3.5 3.5M18.4 5.6L14.9 9.1M9.1 14.9l-3.5 3.5"/></svg>
                {%- when 'scale' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="M7 21h10"/><path d="M12 3v18"/><path d="M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2"/></svg>
                {%- when 'none' -%}
                {%- else -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/></svg>
              {%- endcase -%}
              <h3>{{ block.settings.title | escape }}</h3>
            </div>
            {%- if block.settings.feature_1_label != blank -%}
              <div class="mf25-spec-row"><span>{{ block.settings.feature_1_label | escape }}</span><span>{{ block.settings.feature_1_value | escape }}</span></div>
            {%- endif -%}
            {%- if block.settings.feature_2_label != blank -%}
              <div class="mf25-spec-row"><span>{{ block.settings.feature_2_label | escape }}</span><span>{{ block.settings.feature_2_value | escape }}</span></div>
            {%- endif -%}
            {%- if block.settings.feature_3_label != blank -%}
              <div class="mf25-spec-row"><span>{{ block.settings.feature_3_label | escape }}</span><span>{{ block.settings.feature_3_value | escape }}</span></div>
            {%- endif -%}
            {%- if block.settings.feature_4_label != blank -%}
              <div class="mf25-spec-row"><span>{{ block.settings.feature_4_label | escape }}</span><span>{{ block.settings.feature_4_value | escape }}</span></div>
            {%- endif -%}
            {%- if block.settings.feature_5_label != blank -%}
              <div class="mf25-spec-row"><span>{{ block.settings.feature_5_label | escape }}</span><span>{{ block.settings.feature_5_value | escape }}</span></div>
            {%- endif -%}
            {%- if block.settings.feature_6_label != blank -%}
              <div class="mf25-spec-row"><span>{{ block.settings.feature_6_label | escape }}</span><span>{{ block.settings.feature_6_value | escape }}</span></div>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "MF25 Stitch Specs",
  "tag": "section",
  "class": "section-mf25-stitch-specs",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "Comprehensive Specifications" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 80 }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Spec category",
      "settings": [
        { "type": "text", "id": "title", "label": "Category title", "default": "Frameset" },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "frame", "label": "Frameset / bike" },
            { "value": "battery", "label": "Battery" },
            { "value": "motor", "label": "Motor / gear" },
            { "value": "wheel", "label": "Wheel / tires" },
            { "value": "scale", "label": "Weight / scale" },
            { "value": "none", "label": "None (no icon)" }
          ],
          "default": "frame"
        },
        { "type": "text", "id": "feature_1_label", "label": "Row 1 label" },
        { "type": "text", "id": "feature_1_value", "label": "Row 1 value" },
        { "type": "text", "id": "feature_2_label", "label": "Row 2 label" },
        { "type": "text", "id": "feature_2_value", "label": "Row 2 value" },
        { "type": "text", "id": "feature_3_label", "label": "Row 3 label" },
        { "type": "text", "id": "feature_3_value", "label": "Row 3 value" },
        { "type": "text", "id": "feature_4_label", "label": "Row 4 label" },
        { "type": "text", "id": "feature_4_value", "label": "Row 4 value" },
        { "type": "text", "id": "feature_5_label", "label": "Row 5 label" },
        { "type": "text", "id": "feature_5_value", "label": "Row 5 value" },
        { "type": "text", "id": "feature_6_label", "label": "Row 6 label" },
        { "type": "text", "id": "feature_6_value", "label": "Row 6 value" }
      ]
    }
  ],
  "presets": [
    {
      "name": "MF25 Stitch Specs",
      "blocks": [
        { "type": "category", "settings": { "title": "Frameset", "icon": "frame", "feature_1_label": "Frame", "feature_1_value": "High-Strength Step-Thru Alloy", "feature_2_label": "Fork", "feature_2_value": "Front Suspension Fork with Lockout" } },
        { "type": "category", "settings": { "title": "Display & Drivetrain", "icon": "battery", "feature_1_label": "Display", "feature_1_value": "Full-Color LCD Display", "feature_2_label": "Display Type", "feature_2_value": "LCD Color Screen Display", "feature_3_label": "Rear Derailleur", "feature_3_value": "Shimano 7-Speed", "feature_4_label": "Throttle", "feature_4_value": "Thumb Twist Throttle" } },
        { "type": "category", "settings": { "title": "Wheels & Motor", "icon": "motor", "feature_1_label": "Motor", "feature_1_value": "Maxfoot Brushless Peak 1000W", "feature_2_label": "Tire", "feature_2_value": "26×1.95\" puncture protection" } },
        { "type": "category", "settings": { "title": "Weight & Dimensions", "icon": "scale", "feature_1_label": "Weight limit", "feature_1_value": "300 lbs (136kg)", "feature_2_label": "Dimensions", "feature_2_value": "67.9\" × 38\" × 45\"" } }
      ]
    }
  ]
}
{% endschema %}