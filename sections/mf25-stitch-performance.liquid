
<style>

/* ============================================================
   MF25 STITCH PDP — shared CSS (Stitch v3 mockup)
   Used by all mf25-* sections in product.mf-25-stitch.json
   ============================================================ */
:root{
  --ink:#000000;
  --ink-soft:#1b1c1d;
  --paper:#ffffff;
  --surface:#f8f9fa;
  --surface-2:#e9ecef;
  --surface-3:#dee2e6;
  --signal:#FFC000;
  --signal-deep:#E6AC00;
  --success:#28A745;
  --danger:#E02020;
  --muted:#6B675F;
  --muted-2:#a0a0a0;
  --line:#e5e5e5;
  --display:"Montserrat","Inter",-apple-system,sans-serif;
  --body:"Inter","Helvetica Neue",-apple-system,sans-serif;
  --container:1280px;
  --gutter:24px;
  --section:80px;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{background:var(--paper);color:var(--ink);font-family:var(--body);line-height:1.5;-webkit-font-smoothing:antialiased}
img{display:block;max-width:100%;height:auto}
a{color:inherit;text-decoration:none}
.mf25-container{max-width:var(--container);margin:0 auto;padding:0 var(--gutter)}
@media (max-width:720px){.mf25-container{padding:0 16px}}

/* ENGINEERED FOR PERFORMANCE — Stitch irregular 6-block grid (4 sizes) */
.mf25-eng{background:#0d0d0d;color:#fff;padding:var(--section) 0}
.mf25-eng-head{text-align:center;margin-bottom:40px}
.mf25-eng-eyebrow{font-family:var(--body);font-weight:500;font-size:12px;letter-spacing:.2em;text-transform:uppercase;color:var(--signal);margin-bottom:8px;display:block}
.mf25-eng-head h2{font-family:var(--display);font-weight:700;font-size:clamp(28px,3.5vw,40px);letter-spacing:-0.02em;color:#fff;margin:0}
.mf25-eng-grid{display:grid;grid-template-columns:repeat(4,1fr);grid-auto-rows:200px;gap:8px}
@media (max-width:960px){.mf25-eng-grid{grid-template-columns:repeat(2,1fr);grid-auto-rows:180px}}
@media (max-width:520px){.mf25-eng-grid{grid-template-columns:1fr;grid-auto-rows:160px}}

/* 3 sizes — large (2x2), wide (2x1), tile (1x1) */
.mf25-eng-card{position:relative;overflow:hidden;border-radius:8px;background:#1a1a1a;border:1px solid #2a2a2a}
.mf25-eng-card img{width:100%;height:100%;object-fit:cover;position:absolute;inset:0;opacity:.55;transition:transform .6s}
.mf25-eng-card:hover img{transform:scale(1.05)}
.mf25-eng-card-body{position:absolute;left:0;right:0;bottom:0;padding:24px;display:flex;flex-direction:column;justify-content:flex-end;background:linear-gradient(180deg,rgba(0,0,0,0) 0%,rgba(0,0,0,var(--eng-overlay,.75)) 55%,rgba(0,0,0,var(--eng-overlay-end,.9)) 100%)}
.mf25-eng-card--no-overlay .mf25-eng-card-body{background:transparent}
.mf25-eng-card-body h3{font-family:var(--display);font-weight:700;font-size:20px;letter-spacing:-0.02em;color:#fff;margin-bottom:4px;text-shadow:0 1px 4px rgba(0,0,0,.5)}
.mf25-eng-card-body p{font-family:var(--body);font-size:13px;color:rgba(255,255,255,.9);line-height:1.4;margin:0;text-shadow:0 1px 3px rgba(0,0,0,.4)}

/* large: 2 cols x 2 rows (hero of the grid) — fills two auto-rows */
.mf25-eng-card--large{grid-column:span 2;grid-row:span 2}
/* wide: 2 cols, one row */
.mf25-eng-card--wide{grid-column:span 2}
/* tile: 1 col, one row */
.mf25-eng-card--tile{grid-column:span 1}
/* tablet 2-col: large spans 2 cols x 2 rows */
@media (min-width:521px) and (max-width:960px){
  .mf25-eng-card--large{grid-column:span 2;grid-row:span 2}
  .mf25-eng-card--wide{grid-column:span 1}
  .mf25-eng-card--tile{grid-column:span 1}
}
/* mobile 1-col: every card one row, large not special */
@media (max-width:520px){
  .mf25-eng-card--large{grid-column:span 1;grid-row:span 1}
  .mf25-eng-card--wide{grid-column:span 1}
  .mf25-eng-card--tile{grid-column:span 1}
}
</style>

<section class="mf25-eng" {{ section.shopify_attributes }}>
  <div class="container">
    <div class="mf25-eng-head">
      <span class="mf25-eng-eyebrow">{{ s.eyebrow }}</span>
      <h2>{{ s.title }}</h2>
    </div>
    <div class="mf25-eng-grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'feature' -%}
          <div class="mf25-eng-card mf25-eng-card--{{ block.settings.layout }}{% if block.settings.overlay_enabled == false %} mf25-eng-card--no-overlay{% endif %}" {% if block.settings.overlay_enabled %}style="--eng-overlay:{{ block.settings.overlay_strength | default: 75 | divided_by: 100.0 | round: 2 }};--eng-overlay-end:{{ block.settings.overlay_strength | default: 75 | plus: 15 | divided_by: 100.0 | round: 2 }}"{% endif %} {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              <img src="{{ block.settings.image | image_url: width: 1600 }}" alt="{{ block.settings.title | escape }}" loading="lazy" width="1600" height="1600">
            {%- else -%}
              <img src="https://images.unsplash.com/photo-1571068316344-75bc88f3a3d9?w=1600&h=1600&fit=crop" alt="" loading="lazy" width="1600" height="1600">
            {%- endif -%}
            <div class="mf25-eng-card-body">
              <h3>{{ block.settings.title | escape }}</h3>
              <p>{{ block.settings.body | escape }}</p>
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "MF25 Stitch Performance",
  "tag": "section",
  "class": "section-mf25-stitch-performance",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Built for the ride" },
    { "type": "text", "id": "title", "label": "Title", "default": "Engineered for Performance" }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Performance feature",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "1000W Peak Power" },
        { "type": "textarea", "id": "body", "label": "Body", "default": "High-torque brushless hub motor designed to conquer steep city streets." },
        {
          "type": "select",
          "id": "layout",
          "label": "Card size",
          "options": [
            { "value": "large", "label": "Large (2x2 hero) — image 1200x800 (3:2)" },
            { "value": "wide",  "label": "Wide (2-col strip) — image 1200x400 (3:1)" },
            { "value": "tile",  "label": "Tile (1x1) — image 600x400 (3:2)" }
          ],
          "default": "wide"
        },
        { "type": "image_picker", "id": "image", "label": "Background image",
          "info": "Use the size shown in the Card size option above (it already matches this card). object-fit:cover — matching the ratio avoids cropping. <300KB." },
        { "type": "header", "content": "Text overlay" },
        { "type": "checkbox", "id": "overlay_enabled", "label": "Enable dark overlay behind text", "default": true },
        { "type": "range", "id": "overlay_strength", "label": "Overlay strength", "min": 0, "max": 95, "step": 5, "unit": "%", "default": 75,
          "info": "Darkness of the gradient behind the text. Higher = text easier to read. Only affects this block." }
      ]
    }
  ],
  "presets": [
    {
      "name": "MF25 Stitch Performance",
      "blocks": [
        { "type": "feature", "settings": { "title": "1000W Peak Power", "body": "High-torque brushless hub motor for effortless climbing.", "layout": "large" } },
        { "type": "feature", "settings": { "title": "500Wh Removable Battery", "body": "Up to 55 miles range per charge.", "layout": "wide" } },
        { "type": "feature", "settings": { "title": "LCD Smart Display", "body": "All ride data at a glance.", "layout": "tile" } },
        { "type": "feature", "settings": { "title": "Puncture-Resistant", "body": "Tough tires for any surface.", "layout": "tile" } },
        { "type": "feature", "settings": { "title": "Shimano 7-Speed", "body": "Precision shifting for any terrain.", "layout": "wide" } },
        { "type": "feature", "settings": { "title": "Step-Thru Alloy Frame", "body": "High-strength lightweight construction.", "layout": "wide" } }
      ]
    }
  ]
}
{% endschema %}
