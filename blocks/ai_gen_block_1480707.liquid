{% doc %}
  @prompt
    全宽自动播放视频 hero 区。桌面横向 16:7，竖屏与移动端自动切换为竖版比例。
    视频覆盖可调强度的阴影，文案左置压在阴影之上，视频静音循环播放。
  @endprompt
{% enddoc %}

{%- liquid
  assign ai_id = block.id
  assign ai_shade = block.settings.overlay_opacity | default: 35
  assign ai_alpha = ai_shade | times: 0.01 | round: 2
  assign ai_alpha_mid = ai_shade | times: 0.0045 | round: 3
  assign ai_ratio = block.settings.mobile_ratio | default: '4:5' | split: ':'
  assign ai_ratio_w = ai_ratio[0]
  assign ai_ratio_h = ai_ratio[1]
  assign ai_rgb = '0, 0, 0'
  if block.settings.debug_shade
    assign ai_rgb = '255, 0, 255'
    assign ai_alpha = 1
  endif
-%}

{%- comment -%}
  关键布局样式全部内联在元素上，不依赖 <style> 是否注入成功。
  即使整段样式表失效，遮罩依然以纯色平铺显示。
{%- endcomment -%}

<div
  class="ai-video-hero-{{ ai_id }}"
  style="display:block;position:relative;isolation:isolate;width:100%;max-width:100%;aspect-ratio:16/7;overflow:hidden;background:#1b1b1b;color:#ffffff;"
  {{ block.shopify_attributes }}
>
  {%- if block.settings.video != blank -%}
    <video
      class="ai-video-hero-{{ ai_id }}__media"
      style="position:absolute;top:0;right:0;bottom:0;left:0;width:100%;height:100%;margin:0;object-fit:cover;z-index:0;"
      autoplay
      loop
      muted
      playsinline
      preload="metadata"
      aria-hidden="true"
      tabindex="-1"
    >
      {%- for source in block.settings.video.sources -%}
        <source src="{{ source.url }}" type="{{ source.mime_type }}">
      {%- endfor -%}
    </video>
  {%- else -%}
    <div
      class="ai-video-hero-{{ ai_id }}__placeholder"
      style="position:absolute;top:0;right:0;bottom:0;left:0;display:flex;align-items:center;justify-content:center;background:#333333;"
    >
      {{ 'hero-apparel-1' | placeholder_svg_tag }}
      <div
        class="ai-video-hero-{{ ai_id }}__empty-state"
        style="position:absolute;left:50%;bottom:18px;transform:translateX(-50%);padding:8px 12px;border-radius:3px;background:rgba(0,0,0,0.72);color:#ffffff;font-size:14px;text-align:center;white-space:nowrap;"
      >请在编辑器中选择视频</div>
    </div>
  {%- endif -%}

  <div
    class="ai-video-hero-{{ ai_id }}__shade"
    style="position:absolute;top:0;right:0;bottom:0;left:0;width:100%;height:100%;margin:0;z-index:1;pointer-events:none;background-color:rgba({{ ai_rgb }},{{ ai_alpha }});"
    aria-hidden="true"
  ></div>

  {%- if block.settings.heading != blank or block.settings.copy != blank -%}
    <div
      class="ai-video-hero-{{ ai_id }}__content"
      style="position:absolute;top:0;left:0;z-index:2;width:min(100%,760px);padding:clamp(20px,5vw,72px);color:#ffffff;word-break:break-word;overflow-wrap:anywhere;"
    >
      {%- if block.settings.heading != blank -%}
        <h2
          class="ai-video-hero-{{ ai_id }}__heading"
          style="margin:0 0 14px;color:inherit;font-size:clamp(28px,5vw,64px);line-height:1.08;text-wrap:balance;text-shadow:0 2px 18px rgba(0,0,0,0.45);"
        >{{ block.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if block.settings.copy != blank -%}
        <div
          class="ai-video-hero-{{ ai_id }}__text"
          style="color:inherit;font-size:clamp(16px,1.8vw,21px);line-height:1.5;max-width:34em;text-shadow:0 1px 12px rgba(0,0,0,0.45);"
        >{{ block.settings.copy }}</div>
      {%- endif -%}
    </div>
  {%- endif -%}
</div>

{% style %}
  .ai-video-hero-{{ ai_id }}__text p { margin: 0; }
  .ai-video-hero-{{ ai_id }}__text p + p { margin-top: 0.6em; }
  .ai-video-hero-{{ ai_id }}__placeholder svg { width: 100%; height: 100%; object-fit: cover; opacity: 0.45; }

  .ai-video-hero-{{ ai_id }}__shade {
    background-repeat: no-repeat;
    background-size: 100% 100%;
    background-image:
      linear-gradient(
        100deg,
        rgba(0, 0, 0, {{ ai_alpha }}) 0%,
        rgba(0, 0, 0, {{ ai_alpha }}) 32%,
        rgba(0, 0, 0, {{ ai_alpha_mid }}) 58%,
        rgba(0, 0, 0, 0) 82%
      );
  }

  @media screen and (max-width: 749px) {
    .ai-video-hero-{{ ai_id }} {
      aspect-ratio: {{ ai_ratio_w }} / {{ ai_ratio_h }} !important;
    }

    .ai-video-hero-{{ ai_id }}__content {
      top: auto !important;
      bottom: 0 !important;
      left: 0 !important;
      width: 100% !important;
      padding: 24px 20px 28px !important;
    }

    .ai-video-hero-{{ ai_id }}__heading { margin-bottom: 10px !important; }

    .ai-video-hero-{{ ai_id }}__shade {
      background-image:
        linear-gradient(
          to top,
          rgba(0, 0, 0, {{ ai_alpha }}) 0%,
          rgba(0, 0, 0, {{ ai_alpha }}) 40%,
          rgba(0, 0, 0, {{ ai_alpha_mid }}) 68%,
          rgba(0, 0, 0, 0) 100%
        );
    }
  }

  @media screen and (orientation: portrait) and (min-width: 750px) {
    .ai-video-hero-{{ ai_id }} {
      aspect-ratio: {{ ai_ratio_w }} / {{ ai_ratio_h }} !important;
      max-height: 90vh;
    }

    .ai-video-hero-{{ ai_id }}__content {
      top: auto !important;
      bottom: 0 !important;
      width: min(100%, 720px) !important;
      padding: clamp(32px, 6vh, 72px) !important;
    }

    .ai-video-hero-{{ ai_id }}__shade {
      background-image:
        linear-gradient(
          to top,
          rgba(0, 0, 0, {{ ai_alpha }}) 0%,
          rgba(0, 0, 0, {{ ai_alpha }}) 42%,
          rgba(0, 0, 0, {{ ai_alpha_mid }}) 70%,
          rgba(0, 0, 0, 0) 100%
        );
    }
  }

  @media screen and (max-height: 480px) and (orientation: landscape) {
    .ai-video-hero-{{ ai_id }} { aspect-ratio: 16 / 6 !important; }

    .ai-video-hero-{{ ai_id }}__content { padding: 20px 24px !important; }

    .ai-video-hero-{{ ai_id }}__heading {
      font-size: clamp(22px, 3.4vw, 34px) !important;
      margin-bottom: 8px !important;
    }

    .ai-video-hero-{{ ai_id }}__text { font-size: clamp(14px, 1.5vw, 16px) !important; }
  }
{% endstyle %}

{% schema %}
{
  "name": "自动播放视频横幅",
  "settings": [
    { "type": "video", "id": "video", "label": "视频" },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "覆盖阴影强度",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 35
    },
    {
      "type": "select",
      "id": "mobile_ratio",
      "label": "竖版比例（手机 / 竖屏）",
      "options": [
        { "value": "4:5", "label": "4:5 标准竖版" },
        { "value": "3:4", "label": "3:4 高竖版" },
        { "value": "1:1", "label": "1:1 方版" },
        { "value": "9:16", "label": "9:16 全竖屏" },
        { "value": "16:9", "label": "16:9 标准横版" }
      ],
      "default": "4:5"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "标题",
      "default": "探索城市与远方"
    },
    {
      "type": "richtext",
      "id": "copy",
      "label": "文案",
      "default": "<p>为每一段旅程而生。</p>"
    },
    {
      "type": "checkbox",
      "id": "debug_shade",
      "label": "调试：遮罩显示为洋红色",
      "default": false
    }
  ],
  "presets": [{ "name": "自动播放视频横幅" }]
}
{% endschema %}