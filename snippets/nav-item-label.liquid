{%- comment -%}
  Renders a nav link title with optional badge chip when the title contains
  the inline syntax "[BADGE]" (e.g. "MF-25 [NEW]" → "MF-25" + yellow NEW chip).

  Required: title (the raw link.title)
  Optional: class_prefix (default "nav"), extra_class
{%- endcomment -%}
{%- assign raw = title -%}
{%- assign prefix = class_prefix | default: 'nav' -%}
{%- assign badge = '' -%}
{%- assign title_clean = raw -%}
{%- if raw contains '[' and raw contains ']' -%}
  {%- assign before_text = raw | split: '[' | first -%}
  {%- assign rest = raw | remove: before_text | remove_first: '[' -%}
  {%- if rest contains ']' -%}
    {%- assign badge = rest | split: ']' | first | strip -%}
    {%- assign title_clean = before_text | append: (rest | split: ']' | last) | strip -%}
  {%- endif -%}
{%- endif -%}
{%- assign label_class = prefix | append: '__item-label' -%}
{%- if extra_class != blank -%}
  {%- assign label_class = label_class | append: ' ' | append: extra_class -%}
{%- endif -%}
<span class="{{ label_class }}">
  {{- title_clean | escape -}}
  {%- if badge != blank -%}
    <span class="{{ prefix }}__badge" aria-label="{{ badge | escape }}">{{ badge | escape }}</span>
  {%- endif -%}
</span>