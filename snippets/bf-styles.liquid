{%- comment -%}
  Black Friday family — shared styles. Single CSS source for every `bf-*` section.

  Scoped to `.bf-root` with `--bf-*` tokens so it never touches the global
  theme or the other campaign families (`.mf25-*`, `.mf35-*`, `.sw-*`).
  Mirrors the `mf35-stitch-styles` pattern — do NOT copy the mf25 pattern,
  which writes to `:root` and `*`.
{%- endcomment -%}

<style>
  .bf-root {
    --bf-ink: #121212;
    --bf-accent: #FFC000;
    --bf-accent-dark: #E6AC00;
    --bf-paper: #FFFFFF;
    --bf-soft: #F7F7F5;
    --bf-muted: rgba(255, 255, 255, 0.74);
    --bf-line: rgba(255, 255, 255, 0.16);
    --bf-display: 'Big Shoulders Display', system-ui, sans-serif;
    --bf-body: 'Inter Tight', system-ui, sans-serif;
    --bf-mono: 'JetBrains Mono', ui-monospace, monospace;
    --bf-container: 1320px;
    --bf-gutter: 32px;
    --bf-radius: 4px;
    font-family: var(--bf-body);
    color: var(--bf-ink);
  }
  .bf-root * { box-sizing: border-box; }
  .bf-root img { display: block; }
  .bf-container {
    max-width: var(--bf-container);
    margin: 0 auto;
    padding-left: var(--bf-gutter);
    padding-right: var(--bf-gutter);
  }
  .bf-root a:focus-visible,
  .bf-root button:focus-visible {
    outline: 2px solid var(--bf-accent);
    outline-offset: 3px;
  }

  /* ---------- buttons ---------- */
  .bf-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    font-family: var(--bf-body);
    font-weight: 700;
    font-size: 15px;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 16px 30px;
    border: 1px solid transparent;
    border-radius: 2px;
    cursor: pointer;
    transition: transform 0.2s ease, background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }
  .bf-btn--primary { background: var(--bf-accent); color: var(--bf-ink); }
  .bf-btn--primary:hover { background: #FFD340; color: var(--bf-ink); transform: translateY(-2px); }
  .bf-btn--ghost { background: transparent; color: #fff; border-color: rgba(255, 255, 255, 0.5); }
  .bf-btn--ghost:hover { border-color: #fff; background: rgba(255, 255, 255, 0.08); }

  /* ---------- hero ---------- */
  .bf-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--bf-ink);
    color: #fff;
  }
  .bf-hero__media { position: absolute; inset: 0; z-index: 0; }
  .bf-hero__img { position: absolute; inset: 0; }
  .bf-hero__img img { width: 100%; height: 100%; object-fit: cover; }
  .bf-hero__img--mob { display: none; }
  .bf-hero__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(180deg, rgba(18, 18, 18, 0.32) 0%, rgba(18, 18, 18, 0.7) 48%, rgba(18, 18, 18, 0.96) 100%);
  }
  .bf-hero__scrim::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--bf-ink);
    opacity: var(--bf-overlay, 0.25);
  }
  .bf-hero__inner {
    position: relative;
    z-index: 2;
    max-width: var(--bf-container);
    margin: 0 auto;
    padding: clamp(56px, 8vw, 120px) var(--bf-gutter);
    min-height: clamp(520px, 74vh, 780px);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-start;
    gap: 20px;
  }
  .bf-hero--center .bf-hero__inner { align-items: center; text-align: center; justify-content: center; }
  .bf-hero__eyebrow {
    display: inline-block;
    font-family: var(--bf-mono);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--bf-ink);
    background: var(--bf-accent);
    padding: 8px 14px;
    border-radius: 2px;
  }
  .bf-hero__heading {
    font-family: var(--bf-display);
    font-weight: 900;
    font-size: clamp(52px, 9vw, 132px);
    line-height: 0.92;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    margin: 0;
    max-width: 16ch;
  }
  .bf-hero--center .bf-hero__heading { max-width: 20ch; }
  .bf-hero__sub {
    font-size: clamp(16px, 1.5vw, 20px);
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.92);
    margin: 0;
    max-width: 56ch;
  }
  .bf-hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--bf-mono);
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--bf-accent);
    background: rgba(18, 18, 18, 0.78);
    border: 1px solid rgba(255, 192, 0, 0.5);
    padding: 9px 14px;
    border-radius: 2px;
  }
  .bf-hero__cta { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 6px; }

  /* ---------- countdown ---------- */
  .bf-countdown { margin-top: 8px; }
  .bf-countdown__label {
    display: block;
    font-family: var(--bf-mono);
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.88);
    margin-bottom: 12px;
  }
  .bf-countdown__cells { display: flex; gap: 10px; }
  .bf-countdown__cell {
    min-width: 90px;
    padding: 14px 12px 12px;
    text-align: center;
    background: rgba(18, 18, 18, 0.8);
    border: 1px solid rgba(255, 192, 0, 0.3);
    border-radius: var(--bf-radius);
  }
  .bf-countdown__num {
    display: block;
    font-family: var(--bf-display);
    font-weight: 700;
    font-size: clamp(34px, 4.6vw, 56px);
    line-height: 1;
    color: var(--bf-accent);
    font-variant-numeric: tabular-nums;
  }
  .bf-countdown__unit {
    display: block;
    margin-top: 6px;
    font-family: var(--bf-mono);
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.78);
  }
  .bf-countdown__end { font-size: 15px; line-height: 1.5; color: var(--bf-accent); margin: 14px 0 0; }

  /* ---------- offers ---------- */
  .bf-offers { background: var(--bf-paper); }
  .bf-offers__head { margin-bottom: 34px; max-width: 62ch; }
  .bf-offers__heading {
    font-family: var(--bf-display);
    font-weight: 700;
    font-size: clamp(30px, 4vw, 52px);
    line-height: 1.02;
    text-transform: uppercase;
    margin: 0 0 10px;
  }
  .bf-offers__sub { font-size: 16px; line-height: 1.55; color: #5A5A5A; margin: 0; }
  .bf-offers__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 22px; }
  .bf-offer {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: flex-end;
    min-height: 420px;
    overflow: hidden;
    border-radius: var(--bf-radius);
    background: var(--bf-ink);
    color: #fff;
  }
  .bf-offer__media { position: absolute; inset: 0; z-index: 0; }
  .bf-offer__img { position: absolute; inset: 0; }
  .bf-offer__img img { width: 100%; height: 100%; object-fit: cover; }
  .bf-offer__img--mob { display: none; }
  .bf-offer__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(180deg, rgba(18, 18, 18, 0.22) 0%, rgba(18, 18, 18, 0.6) 45%, rgba(18, 18, 18, 0.95) 100%);
  }
  .bf-offer__body { position: relative; z-index: 2; width: 100%; padding: 30px 28px 26px; }
  .bf-offer__kicker {
    font-family: var(--bf-mono);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--bf-accent);
    margin: 0 0 10px;
  }
  .bf-offer__heading {
    font-family: var(--bf-display);
    font-weight: 700;
    font-size: clamp(26px, 3.2vw, 42px);
    line-height: 1.02;
    text-transform: uppercase;
    margin: 0 0 14px;
  }
  .bf-offer__value {
    display: inline-block;
    font-family: var(--bf-mono);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    background: var(--bf-accent);
    color: var(--bf-ink);
    padding: 8px 12px;
    border-radius: 2px;
    margin: 0 0 12px;
  }
  .bf-offer__date {
    font-family: var(--bf-mono);
    font-size: 13px;
    letter-spacing: 0.08em;
    color: var(--bf-muted);
    margin: 0 0 18px;
  }
  .bf-offer--dark { background: linear-gradient(160deg, #1C1C1C 0%, #0A0A0A 60%); }
  .bf-offer--dark::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
    border: 2px solid rgba(255, 192, 0, 0.55);
  }
  .bf-offer--dark .bf-offer__kicker { color: #fff; }
  .bf-offer--dark .bf-offer__value { background: #fff; color: var(--bf-ink); }

  /* ---------- responsive ---------- */
  @media screen and (max-width: 990px) {
    .bf-offers__grid { grid-template-columns: 1fr; }
    .bf-offer { min-height: 360px; }
  }
  @media screen and (max-width: 749px) {
    .bf-root { --bf-gutter: 20px; }
    .bf-hero__inner { min-height: clamp(460px, 80vh, 640px); padding-top: 48px; padding-bottom: 48px; }
    .bf-countdown__cells { gap: 8px; }
    .bf-countdown__cell { min-width: 0; flex: 1 1 0; padding: 12px 6px 10px; }
    .bf-offer__body { padding: 24px 20px 22px; }
    .bf-hero--has-mobile .bf-hero__img--desk { display: none; }
    .bf-hero--has-mobile .bf-hero__img--mob { display: block; }
    .bf-offer--has-mobile .bf-offer__img--desk { display: none; }
    .bf-offer--has-mobile .bf-offer__img--mob { display: block; }
  }
  @media (prefers-reduced-motion: reduce) {
    .bf-btn { transition: none; }
    .bf-btn--primary:hover { transform: none; }
  }
</style>
